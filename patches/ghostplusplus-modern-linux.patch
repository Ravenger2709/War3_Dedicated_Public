+// Phase 3 gameplay runs only on GHost's socket event loop. PID votes are removed
+// before player deletion, so a reconnect/reused PID never inherits a ballot.
+uint32_t CBaseGame :: NativeMaxPlayers( )
+{
+	if( !m_Map ) return min( m_GHost->m_MaxPlayers, m_NativeCapacity );
+	vector<CGameSlot> original = m_Map->GetSlots( );
+	uint32_t slots = 0;
+	for( size_t i = 0; i < original.size( ); ++i )
+		if( original[i].GetTeam( ) < 12 && original[i].GetColour( ) < 12 ) ++slots;
+	return min( m_GHost->m_MaxPlayers, min( m_Map->GetMapNumPlayers( ), slots ) );
+}
+
+bool CBaseGame :: NativeAIEnabled( )
+{
+	return m_NativeAISupported && m_GHost->m_LobbyAISupported && m_GHost->m_LobbyAITarget >= 2 && m_GHost->m_LobbyAITarget <= NativeMaxPlayers( ) && m_GameState == GAME_PUBLIC && !m_SaveGame && m_EnforceSlots.empty( ) && m_EnforcePlayers.empty( );
+}
+
+uint32_t CBaseGame :: NativeComputerPlayers( )
+{
+	uint32_t result = 0;
+	for( size_t i = 0; i < m_Slots.size( ); ++i )
+		if( m_Slots[i].GetSlotStatus( ) == SLOTSTATUS_OCCUPIED && m_Slots[i].GetComputer( ) && m_Slots[i].GetTeam( ) < 12 && m_Slots[i].GetColour( ) < 12 ) ++result;
+	return result;
+}
+
+uint32_t CBaseGame :: NativeOwnedAIPlayers( )
+{
+	uint32_t result = 0;
+	for( map<unsigned char,pair<CGameSlot,CGameSlot> >::iterator i = m_NativeAISlots.begin( ); i != m_NativeAISlots.end( ); ++i )
+		if( i->first < m_Slots.size( ) && m_Slots[i->first].GetByteArray( ) == i->second.second.GetByteArray( ) ) ++result;
+	return result;
+}
+
+uint32_t CBaseGame :: NativeReservedHeadroom( )
+{
+	set<string> pending;
+	for( size_t i = 0; i < m_Reserved.size( ); ++i ) if( !GetPlayerFromName( m_Reserved[i], false ) ) pending.insert( m_Reserved[i] );
+	if( !m_OwnerName.empty( ) && !GetPlayerFromName( m_OwnerName, false ) )
