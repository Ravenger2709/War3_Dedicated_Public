+bool CGHost :: PersistNativeGameStarted( uint32_t hostCounter, string &matchID )
+{
+    if( m_LifecycleDirectory.empty( ) ) return true;
+#ifndef WIN32
+    if( !m_LifecycleValid ) return false;
+    int dir = NativeOpenLifecycleDirectory( );
+    string id;
+    if( dir < 0 || !NativeRandomID( id ) ) { if( dir >= 0 ) close( dir ); return false; }
+    string base = "start-" + m_LifecycleGeneration + "-" + id;
+    string temp = "." + base + ".tmp";
+    string name = base + ".json";
+    string payload = "{\"version\":1,\"event\":\"game_started\",\"session_generation\":\"" + m_LifecycleGeneration +
+        "\",\"match_id\":\"" + id + "\",\"host_counter\":" + UTIL_ToString( hostCounter & 0x0fffffff ) + "}\n";
+    int fd = openat( dir, temp.c_str( ), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600 );
+    bool ok = fd >= 0 && fchmod( fd, 0600 ) == 0;
+    size_t offset = 0;
+    while( ok && offset < payload.size( ) )
+    {
+        ssize_t n = write( fd, payload.data( ) + offset, payload.size( ) - offset );
+        if( n < 0 && errno == EINTR ) continue;
+        if( n <= 0 ) { ok = false; break; }
+        offset += n;
+    }
+    if( ok && fsync( fd ) ) ok = false;
+    if( fd >= 0 && close( fd ) ) ok = false;
+    // Confirm the configured directory has not been replaced before publishing.
+    int current = NativeOpenLifecycleDirectory( );
+    struct stat held, now;
+    if( current < 0 || fstat( dir, &held ) || fstat( current, &now ) || held.st_dev != now.st_dev || held.st_ino != now.st_ino ) ok = false;
+    if( current >= 0 ) close( current );
+    bool renamed = false;
+    if( ok )
+    {
+        if( syscall( SYS_renameat2, dir, temp.c_str( ), dir, name.c_str( ), RENAME_NOREPLACE ) ) ok = false;
+        else renamed = true;
+    }
+    if( ok && fsync( dir ) ) ok = false;
+    if( !renamed ) unlinkat( dir, temp.c_str( ), 0 );
+    close( dir );
+    if( !ok ) return false;
+    // Publish the ID to this game only after the durable journal commit.
+    matchID.swap( id );
+    CONSOLE_Print( "[HOSTBOT_LIFECYCLE] " + payload.substr( 0, payload.size( ) - 1 ) );
+    return true;
+#else
+    return false;
+#endif
+}
