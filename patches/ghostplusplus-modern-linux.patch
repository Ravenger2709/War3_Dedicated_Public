+// Reservation markers are immutable, private files published only after the
+// supervisor's reservation is durable. Sync both file and directory before
+// trusting a marker that may be visible just before the publisher's dir fsync.
+bool CGHost :: NativeStartReserved( uint32_t hostCounter )
+{
+    if( !m_StartReservationGate ) return true;
+#ifndef WIN32
+    if( !m_LifecycleValid || m_LifecycleDirectory.empty( ) || hostCounter == 0 || hostCounter > 0x0fffffff ) return false;
+    int dir = NativeOpenLifecycleDirectory( );
+    if( dir < 0 ) return false;
+    string count = UTIL_ToString( hostCounter );
+    string name = "reservation-" + m_LifecycleGeneration + "-" + count + ".ready";
+    string expected = "version=1\nsession_generation=" + m_LifecycleGeneration + "\nhost_counter=" + count + "\n";
+    int fd = openat( dir, name.c_str( ), O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC );
+    struct stat before, after, named, held, currentStat;
+    bool ok = fd >= 0 && !fstat( fd, &before ) && S_ISREG( before.st_mode ) && before.st_uid == geteuid( ) &&
+        ( before.st_mode & 07777 ) == 0600 && before.st_nlink == 1 && before.st_size == (off_t)expected.size( );
+    string contents;
+    char bytes[256];
+    while( ok )
+    {
+        ssize_t n = read( fd, bytes, sizeof bytes );
+        if( n < 0 && errno == EINTR ) continue;
+        if( n < 0 ) { ok = false; break; }
+        if( n == 0 ) break;
+        contents.append( bytes, n );
+        if( contents.size( ) > 128 ) { ok = false; break; }
+    }
+    ok = ok && contents == expected;
+    if( ok && fsync( fd ) ) ok = false;
+    if( ok && fsync( dir ) ) ok = false;
+    int current = NativeOpenLifecycleDirectory( );
+    ok = ok && current >= 0 && !fstat( dir, &held ) && !fstat( current, &currentStat ) &&
+        held.st_dev == currentStat.st_dev && held.st_ino == currentStat.st_ino &&
+        !fstat( fd, &after ) && !fstatat( dir, name.c_str( ), &named, AT_SYMLINK_NOFOLLOW ) &&
+        before.st_dev == after.st_dev && before.st_ino == after.st_ino &&
+        before.st_size == after.st_size && before.st_mtim.tv_sec == after.st_mtim.tv_sec &&
+        before.st_mtim.tv_nsec == after.st_mtim.tv_nsec && before.st_ctim.tv_sec == after.st_ctim.tv_sec &&
+        before.st_ctim.tv_nsec == after.st_ctim.tv_nsec && before.st_mode == after.st_mode &&
+        before.st_uid == after.st_uid && after.st_nlink == 1 && named.st_dev == after.st_dev && named.st_ino == after.st_ino;
+    if( current >= 0 ) close( current );
+    if( fd >= 0 ) close( fd );
+    close( dir );
+    return ok;
+#else
+    return false;
+#endif
+}
