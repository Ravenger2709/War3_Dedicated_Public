+// This runs only on the host event loop. Staging is durable before this check;
+// full capacity or an occupied lobby waits without changing the request.
+int CNativeStartupCatalog :: CheckAdmission( CGHost *host, CMap *map, const string &gameName ) const
+{
+    if( !host || host!=m_Owner || host->m_NativeAdmissionCatalog!=this ||
+        (host->m_NativeStartupCatalog && host->m_NativeStartupCatalog!=this) ||
+        m_IPCBlocked || !host->m_LifecycleValid ||
+        host->m_LifecycleGeneration!=m_SessionGeneration || m_StagedID.empty() ||
+        m_StagedIndex>=m_Entries.size() || host->m_NativePendingCatalogID!=m_StagedID ||
+        host->m_NativePendingCatalogDigest!=m_ManifestDigest ||
+        host->m_NativePendingCatalogIndex!=m_StagedIndex || !host->m_NativePendingPreset ||
+        !map || map!=host->m_NativePendingMap || gameName!=m_Entries[m_StagedIndex].Settings.GameName ||
+        host->m_NativePendingPreset->GameName!=gameName || host->m_MaxGames!=m_MaxGames ) return -1;
+    const Entry &entry=m_Entries[m_StagedIndex];
+    const NativeNextPreset &actual=*host->m_NativePendingPreset, &expected=entry.Settings;
+    if( !entry.Map || map->GetMapPath()!=entry.Map->GetMapPath() || map->GetMapSize()!=entry.Map->GetMapSize() ||
+        map->GetMapCRC()!=entry.Map->GetMapCRC() || map->GetMapSHA1()!=entry.Map->GetMapSHA1() ||
+        actual.GameName!=expected.GameName || actual.VoteEnabled!=expected.VoteEnabled ||
+        actual.LobbyRefreshEnabled!=expected.LobbyRefreshEnabled || actual.LobbyAISupported!=expected.LobbyAISupported ||
+        actual.AutoStartEnabled!=expected.AutoStartEnabled || actual.MaxPlayers!=expected.MaxPlayers ||
+        actual.DefaultAutoStartPlayers!=expected.DefaultAutoStartPlayers || actual.VoteRequiredPercent!=expected.VoteRequiredPercent ||
+        actual.VoteMinPlayers!=expected.VoteMinPlayers || actual.VoteTimeout!=expected.VoteTimeout ||
+        actual.VoteCooldown!=expected.VoteCooldown || actual.LobbyRefreshInterval!=expected.LobbyRefreshInterval ||
+        actual.LobbyAITarget!=expected.LobbyAITarget || actual.LobbyAISkill!=expected.LobbyAISkill ||
+        actual.LobbyMinHumans!=expected.LobbyMinHumans || actual.CountDownSeconds!=expected.CountDownSeconds ) return -1;
+    if( host->m_CurrentGame || host->m_AutoHostMaximumGames==0 ||
+        host->m_Games.size()>=host->m_MaxGames || host->m_Games.size()>=host->m_AutoHostMaximumGames ) return 0;
+    return 1;
+}
