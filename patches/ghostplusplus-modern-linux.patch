+	}
+	uint32_t projected = eligible.size( );
+	if( slot.GetSlotStatus( ) == SLOTSTATUS_OCCUPIED && eligible.count( slot.GetPID( ) ) ) --projected;
+	if( playable ) ++projected;
+	return projected <= NativeMaxPlayers( ) && ( !m_G1Bridge.enabled( ) || m_GHost->m_G1Mode != 3 || projected <= 11 );
+}
+
+uint32_t CBaseGame :: NativeAutoStartPlayers( )
+{
+	return m_NativeGameplay.AutoStartEnabled && m_AutoStartPlayers ? min( m_AutoStartPlayers, NativeMaxPlayers( ) ) : 0;
+}
+
+set<unsigned char> CBaseGame :: NativeEligiblePlayers( )
+{
+	set<unsigned char> eligible;
+	for( size_t i = 0; i < m_Slots.size( ); ++i )
+	{
+		CGameSlot &slot = m_Slots[i];
+		if( slot.GetSlotStatus( ) != SLOTSTATUS_OCCUPIED || slot.GetComputer( ) || slot.GetTeam( ) >= 12 || slot.GetColour( ) >= 12 ) continue;
+		CGamePlayer *player = GetPlayerFromPID( slot.GetPID( ) );
+		if( player && !player->GetDeleteMe( ) && !player->GetLeftMessageSent( ) && player->GetPID( ) != m_VirtualHostPID && player->GetPID( ) != m_FakePlayerPID ) eligible.insert( player->GetPID( ) );
+	}
+	return eligible;
+}
+
+uint32_t CBaseGame :: NativeVotesRequired( )
+{
+	return max( (uint32_t)( m_NativeGameplay.VoteMinPlayers == 1 && NativeSingleHumanAIReady( ) ? 1 : 2 ), ( (uint32_t)NativeEligiblePlayers( ).size( ) * m_NativeGameplay.VoteRequiredPercent + 99 ) / 100 );
+}
+
+BYTEARRAY CBaseGame :: NativeComposition( )
+{
+	BYTEARRAY result;
+	for( size_t i = 0; i < m_Slots.size( ); ++i )
+		UTIL_AppendByteArray( result, m_Slots[i].GetByteArray( ) );
+	set<unsigned char> eligible = NativeEligiblePlayers( );
+	result.insert( result.end( ), eligible.begin( ), eligible.end( ) );
+	return result;
+}
+
+bool CBaseGame :: NativeStartReady( string &reason )
+{
+	if( m_Exiting || m_GameLoading || m_GameLoaded || !m_Map->GetValid( ) || !m_NativeGameplay.Phase3ConfigValid ) { reason = "game is unavailable."; return false; }
+	set<unsigned char> eligible = NativeEligiblePlayers( );
+	if( eligible.size( ) < NativeMinimumHumans( ) ) { reason = "we need more players before starting."; return false; }
+	if( eligible.size( ) == 1 && !NativeSingleHumanAIReady( ) && !m_G1Bridge.enabled( ) ) { reason = "a computer opponent is needed for a solo game."; return false; }
+	if( eligible.size( ) > NativeMaxPlayers( ) ) { reason = "there are too many players for this map."; return false; }
+	vector<CGameSlot> original = m_Map->GetSlots( );
+	if( original.size( ) != m_Slots.size( ) || m_Slots.size( ) > 12 ) { reason = "the map's player slots are invalid."; return false; }
+	set<unsigned char> colours, teams;
+	uint32_t occupied = 0;
+	for( size_t i = 0; i < m_Slots.size( ); ++i )
+	{
+		CGameSlot &slot = m_Slots[i];
+		if( slot.GetSlotStatus( ) != SLOTSTATUS_OCCUPIED ) continue;
+		bool fake = m_FakePlayerPID != 255 && slot.GetPID( ) == m_FakePlayerPID;
+		if( !slot.GetComputer( ) && !fake )
+		{
+			CGamePlayer *player = GetPlayerFromPID( slot.GetPID( ) );
+			if( !player || player->GetDeleteMe( ) || slot.GetDownloadStatus( ) != 100 ) { reason = "everyone needs to finish downloading the map."; return false; }
+			if( m_GHost->m_RequireSpoofChecks && !player->GetSpoofed( ) ) { reason = "we are still checking player names."; return false; }
+		}
+		if( slot.GetTeam( ) == 12 && slot.GetColour( ) == 12 ) continue;
+		if( slot.GetTeam( ) >= 12 || slot.GetColour( ) >= 12 || !colours.insert( slot.GetColour( ) ).second ) { reason = "players need different colours and valid teams."; return false; }
+		if( ( m_Map->GetMapOptions( ) & MAPOPT_CUSTOMFORCES ) && slot.GetTeam( ) != original[i].GetTeam( ) ) { reason = "players must stay on the teams set by the map."; return false; }
+		if( ( m_Map->GetMapOptions( ) & MAPOPT_FIXEDPLAYERSETTINGS ) && slot.GetColour( ) != original[i].GetColour( ) ) { reason = "players must use the colours set by the map."; return false; }
+		teams.insert( slot.GetTeam( ) );
+		++occupied;
+	}
+	if( occupied > ( NativeAIEnabled( ) ? m_Map->GetMapNumPlayers( ) : NativeMaxPlayers( ) ) || ( m_Map->GetMapNumTeams( ) > 1 && teams.size( ) < 2 ) ) { reason = "there are too many players or the teams need opponents."; return false; }
+	if( m_MatchMaking && ( !m_AutoStartPlayers || eligible.size( ) < min( m_AutoStartPlayers, NativeMaxPlayers( ) ) ) ) { reason = "matchmaking is waiting for more players."; return false; }
+	if( m_HCLCommandString.size( ) > GetSlotsOccupied( ) || m_HCLCommandString.find_first_not_of( "abcdefghijklmnopqrstuvwxyz0123456789 -=,." ) != string::npos ) { reason = "the map's start settings are invalid."; return false; }
+	return true;
+}
+
+void CBaseGame :: CancelNativeVote( const string &reason, bool cooldown )
+{
+	bool active = m_VoteActive || !m_StartVotes.empty( );
+	m_VoteActive = false;
+	m_StartVotes.clear( );
+	if( m_CountdownKind == 1 )
+	{
+		m_CountDownStarted = false;
+		m_CountDownCounter = 0;
+		m_CountdownKind = 0;
+	}
+	if( active )
+	{
+		m_VoteCooling = cooldown;
+		m_VoteCooldownTicks = GetTicks( );
+		if( !reason.empty( ) ) SendAllChat( "Vote " + reason + "." );
+	}
+}
+
+void CBaseGame :: UpdateNativeGameplay( )
+{
+	if( m_NativeRefreshSID != 255 )
+	{
+		if( m_Exiting || m_GameLoading || m_GameLoaded || m_CountDownStarted || m_VoteActive || !m_Potentials.empty( ) ) RestoreNativeRefresh( );
+		else if( GetTicks( ) - m_NativeRefreshTicks >= 1000 ) RestoreNativeRefresh( true, true );
+	}
+	ReconcileNativeAI( );
+	set<unsigned char> eligible = NativeEligiblePlayers( );
+	for( set<unsigned char>::iterator i = m_StartVotes.begin( ); i != m_StartVotes.end( ); )
+		if( !eligible.count( *i ) ) m_StartVotes.erase( i++ ); else ++i;
+	if( m_GameLoading || m_GameLoaded )
+	{
+		m_StartVotes.clear( ); m_VoteActive = m_VoteCooling = false; m_CountdownKind = 0;
+		return;
+	}
+	if( m_VoteCooling && GetTicks( ) - m_VoteCooldownTicks >= m_NativeGameplay.VoteCooldown * 1000 ) m_VoteCooling = false;
+	if( !m_CountDownStarted && m_CountdownKind )
+	{
+		// The existing join/leave/abort handlers can cancel a countdown first.
+		CancelNativeVote( "cancelled because players joined, left or changed slots" );
+		m_CountdownKind = 0;
+	}
+	if( m_CountDownStarted )
+	{
+		string reason;
+		bool valid = NativeStartReady( reason ) && NativeComposition( ) == m_CountdownComposition;
+		if( m_CountdownKind == 1 ) valid = valid && eligible.size( ) >= max( m_NativeGameplay.VoteMinPlayers, NativeMinimumHumans( ) ) && m_StartVotes.size( ) >= NativeVotesRequired( );
+		if( m_CountdownKind == 2 ) valid = valid && NativeAutoStartPlayers( ) && eligible.size( ) >= NativeAutoStartPlayers( );
+		if( !valid )
+		{
+			m_CountDownStarted = false;
+			m_CountDownCounter = 0;
+			CancelNativeVote( "cancelled because the game is no longer ready to start" );
+			m_CountdownKind = 0;
+			SendAllChat( "Countdown cancelled because players or teams changed." );
+		}
+		else if( m_CountdownKind != 1 ) { m_StartVotes.clear( ); m_VoteActive = false; }
+		return;
+	}
+	if( m_VoteActive )
+	{
+		if( !m_NativeGameplay.VoteEnabled || eligible.size( ) < max( m_NativeGameplay.VoteMinPlayers, NativeMinimumHumans( ) ) || m_SaveGame ) CancelNativeVote( "cancelled because we need more players" );
+		else if( GetTicks( ) - m_VoteStartedTicks >= m_NativeGameplay.VoteTimeout * 1000 ) CancelNativeVote( "timed out" );
+		else if( m_StartVotes.size( ) >= NativeVotesRequired( ) )
+		{
+			m_CountdownKind = 1;
+			StartCountDown( false );
+			if( m_CountDownStarted )
+			{
+				m_VoteActive = false;
+				SendAllChat( "Vote passed! The game starts in " + UTIL_ToString( m_NativeGameplay.CountDownSeconds ) + ( m_NativeGameplay.CountDownSeconds == 1 ? " second." : " seconds." ) );
+			}
+			else { CancelNativeVote( "passed. Complete the readiness checks above, then type !vote again" ); m_CountdownKind = 0; }
+		}
+	}
+	if( !m_CountDownStarted && m_NativeRefreshSID == 255 && m_NativeGameplay.LobbyRefreshEnabled && GetTicks( ) - m_LastLobbyRefreshTicks >= m_NativeGameplay.LobbyRefreshInterval * 1000 )
+	{
+		m_LastLobbyRefreshTicks = GetTicks( );
+		NativeRefresh( );
+	}
+}
+
+void CBaseGame :: NativeVote( CGamePlayer *player )
+{
+	UpdateNativeGameplay( );
+	if( !player || player->GetDeleteMe( ) ) return;
+	set<unsigned char> eligible = NativeEligiblePlayers( );
+	string message, reason;
+	if( !m_NativeGameplay.VoteEnabled ) message = "Voting is disabled.";
+	else if( m_GameLoading || m_GameLoaded || m_CountDownStarted || m_SaveGame ) message = "Voting is unavailable while the game is starting or running.";
+	else if( !eligible.count( player->GetPID( ) ) ) message = "Only players taking part in the game can vote.";
+	else if( eligible.size( ) < max( m_NativeGameplay.VoteMinPlayers, NativeMinimumHumans( ) ) ) message = NativeHumanRequirement( "Voting requires at least ", max( m_NativeGameplay.VoteMinPlayers, NativeMinimumHumans( ) ), eligible.size( ) );
+	else if( eligible.size( ) == 1 && !NativeStartReady( reason ) ) message = "Cannot start yet: " + reason;
+	else if( m_VoteCooling ) message = "Please wait before starting another vote.";
+	else if( m_StartVotes.count( player->GetPID( ) ) ) message = "You already voted.";
+	else
+	{
+		bool first = !m_VoteActive;
+		if( first ) { RestoreNativeRefresh( ); m_VoteActive = true; m_VoteStartedTicks = GetTicks( ); }
+		m_StartVotes.insert( player->GetPID( ) );
+		SendAllChat( string( first ? "Vote started: " : "Vote: " ) + UTIL_ToString( (uint32_t)m_StartVotes.size( ) ) + "/" + UTIL_ToString( NativeVotesRequired( ) ) + ". Type !vote to join the vote." );
+		UpdateNativeGameplay( );
+		return;
+	}
+	// Rate-limit duplicate/denied replies as well as the status/help response.
+	uint32_t now = GetTicks( );
+	if( !m_PublicCommandTicks.count( player->GetPID( ) ) || now - m_PublicCommandTicks[player->GetPID( )] >= 5000 )
+	{
+		m_PublicCommandTicks[player->GetPID( )] = now;
+		SendChat( player, message );
+	}
+}
+
+// One democratic poll belongs to this CBaseGame, never to a host or PID alone.
+map<unsigned char,CGamePlayer *> CBaseGame :: NativeKickHumans( )
+{
+    map<unsigned char,CGamePlayer *> members;
+    for(size_t i=0;i<m_Slots.size();++i)
+    {
+        CGameSlot &slot=m_Slots[i];
+        if(slot.GetSlotStatus()!=SLOTSTATUS_OCCUPIED || slot.GetComputer()) continue;
+        CGamePlayer *p=GetPlayerFromPID(slot.GetPID());
+        if(p && !p->GetDeleteMe() && !p->GetLeftMessageSent() &&
+           p->GetPID()!=m_VirtualHostPID && p->GetPID()!=m_FakePlayerPID) members[p->GetPID()]=p;
+    }
+    return members;
+}
+
+void CBaseGame :: CancelNativeKick( const string &message )
+{
+    if(!m_NativeKickActive) return;
+    m_NativeKickActive=false; m_NativeKickCooling=true;
+    m_NativeKickCooldownMS=NativeMonotonicMS();
+    m_NativeKickTarget=255; m_NativeKickRequired=0;
+    m_NativeKickMembers.clear(); m_NativeKickYes.clear();
+    if(!message.empty()) SendAllChat(message);
+}
+
+void CBaseGame :: UpdateNativeKick( )
+{
+    uint64_t now=NativeMonotonicMS();
+    if(m_NativeKickCooling && now-m_NativeKickCooldownMS>=30000) m_NativeKickCooling=false;
+    if(!m_NativeKickActive) return;
+    map<unsigned char,CGamePlayer *> members=NativeKickHumans();
+    if(!members.count(m_NativeKickTarget) || members[m_NativeKickTarget]!=m_NativeKickMembers[m_NativeKickTarget])
+        CancelNativeKick("Kick vote cancelled because the target left.");
+    else if(members!=m_NativeKickMembers)
+        CancelNativeKick("Kick vote cancelled because players joined or left.");
+    else if(!m_GameLoaded || m_Exiting || m_SaveGame)
+        CancelNativeKick("Kick vote cancelled because the match is unavailable.");
+    else if(now-m_NativeKickStartedMS>=60000)
+        CancelNativeKick("Kick vote expired.");
+}
+
+static string NativeKickFold( string value )
+{
+    for(size_t i=0;i<value.size();++i)
+        if(value[i]>='A' && value[i]<='Z') value[i]=(char)(value[i]-'A'+'a');
+    return value;
+}
+
+void CBaseGame :: NativeKick( CGamePlayer *player, string payload, bool yes )
+{
+    UpdateNativeKick();
+    if(!player || player->GetDeleteMe() || player->GetLeftMessageSent()) return;
+    uint64_t now=NativeMonotonicMS(); unsigned char pid=player->GetPID();
+    if(m_NativeKickCommandMS.count(pid) && now-m_NativeKickCommandMS[pid]<1000) return;
+    m_NativeKickCommandMS[pid]=now;
+    if(!m_GameLoaded || m_Exiting || m_SaveGame)
+    { SendChat(player,"Kick voting is available only in a running match."); return; }
+    map<unsigned char,CGamePlayer *> members=NativeKickHumans();
+    if(!members.count(pid) || members[pid]!=player)
+    { SendChat(player,"Only eligible human players may vote."); return; }
+    size_t begin=payload.find_first_not_of(" \t"), end=payload.find_last_not_of(" \t");
+    payload=begin==string::npos ? string() : payload.substr(begin,end-begin+1);
+    if(payload.empty() && !yes)
+    {
+        if(m_NativeKickActive)
+        {
+            CGamePlayer *target=members[m_NativeKickTarget];
+            SendChat(player,"Kick vote: "+target->GetName()+" | Yes: "+UTIL_ToString((uint32_t)m_NativeKickYes.size())+"/"+
+                UTIL_ToString(m_NativeKickRequired)+" | Eligible voters: "+UTIL_ToString((uint32_t)m_NativeKickMembers.size()-1)+".");
+        }
+        else SendChat(player,"Usage: !kick <player> or !yes. Kick votes require 70% of eligible humans (target excluded) and at least 2 yes votes.");
+        return;
+    }
+    if(m_NativeKickCooling)
+    {
+        uint32_t seconds=(uint32_t)((30000-(now-m_NativeKickCooldownMS)+999)/1000);
+        SendChat(player,"Kick voting is cooling down. Try again in "+UTIL_ToString(seconds)+" seconds."); return;
+    }
+    CGamePlayer *target=NULL;
+    if(yes)
+    {
+        if(!m_NativeKickActive) { SendChat(player,"No kick vote is active."); return; }
+        target=members[m_NativeKickTarget];
+    }
+    else
+    {
+        string folded=NativeKickFold(payload); uint32_t matches=0;
+        for(map<unsigned char,CGamePlayer *>::iterator i=members.begin();i!=members.end();++i)
+            if(NativeKickFold(i->second->GetName())==folded) { target=i->second; matches=1; break; }
+        if(!target) for(map<unsigned char,CGamePlayer *>::iterator i=members.begin();i!=members.end();++i)
+            if(NativeKickFold(i->second->GetName()).find(folded)!=string::npos) { target=i->second; ++matches; }
+        if(!matches) { SendChat(player,"No matching human player found."); return; }
+        if(matches!=1) { SendChat(player,"Player name is ambiguous. Use the full name."); return; }
+    }
+    if(target==player)
+    { SendChat(player,m_NativeKickActive ? "The target cannot vote." : "You cannot vote to kick yourself."); return; }
+    if(m_NativeKickActive && target->GetPID()!=m_NativeKickTarget)
+    { SendChat(player,"A kick vote for another player is already active."); return; }
+    if(!m_NativeKickActive)
+    {
+        if(members.size()<3) { SendChat(player,"Kick voting requires at least 3 human players."); return; }
+        m_NativeKickMembers=members; m_NativeKickTarget=target->GetPID();
+        m_NativeKickRequired=max((uint32_t)2,((uint32_t)(members.size()-1)*70+99)/100);
+        m_NativeKickYes.clear(); m_NativeKickYes.insert(pid);
+        m_NativeKickStartedMS=now; m_NativeKickActive=true;
+        SendAllChat("Kick vote started for "+target->GetName()+": 1/"+UTIL_ToString(m_NativeKickRequired)+
+            " yes votes. Type !yes or !kick "+target->GetName()+".");
+        return;
+    }
+    if(!m_NativeKickYes.insert(pid).second)
+    { SendChat(player,"You have already voted yes."); return; }
+    if(m_NativeKickYes.size()<m_NativeKickRequired)
+    {
+        SendAllChat("Kick vote accepted for "+target->GetName()+": "+UTIL_ToString((uint32_t)m_NativeKickYes.size())+
+            "/"+UTIL_ToString(m_NativeKickRequired)+" yes votes."); return;
+    }
+    // Revalidate the full fixed membership immediately before the only removal.
+    UpdateNativeKick();
+    if(!m_NativeKickActive) return;
+    CancelNativeKick("Kick vote passed for "+target->GetName()+".");
+    target->SetDeleteMe(true); target->SetLeftReason("was removed by a democratic kick vote");
+    target->SetLeftCode(PLAYERLEAVE_LOST);
+}
+
+void CBaseGame :: NativeStatus( CGamePlayer *player, bool diagnostic, bool help )
+{
+	if( !player || player->GetDeleteMe( ) ) return;
+	uint32_t now = GetTicks( );
+	if( m_PublicCommandTicks.count( player->GetPID( ) ) && now - m_PublicCommandTicks[player->GetPID( )] < 5000 ) return;
+	m_PublicCommandTicks[player->GetPID( )] = now;
+	m_GHost->UpdateNativeFeedback( true );
+	uint64_t uptime = ( NativeMonotonicMS( ) - m_GHost->m_NativeStartedMS ) / 1000;
+	string hours = UTIL_ToString( uptime / 3600 ), minutes = UTIL_ToString( (uint32_t)( uptime / 60 % 60 ) ), seconds = UTIL_ToString( (uint32_t)( uptime % 60 ) );
+	if( hours.size( ) < 2 ) hours = "0" + hours;
+	if( minutes.size( ) < 2 ) minutes = "0" + minutes;
+	if( seconds.size( ) < 2 ) seconds = "0" + seconds;
+	string map = m_NativeMapName;
+	uint32_t countdown = m_CountDownStarted && !m_GameLoading && !m_GameLoaded ? ( m_CountDownCounter + 1 ) / 2 : 0;
+	SendChat( player, m_GHost->m_StatusName + " | iCCup: " + ( m_GHost->m_NativeOnline ? "Online" : "Offline" ) );
+	SendChat( player, "Lobby: " + m_GameName + " | Map: " + map );
+	SendChat( player, "Preset: " + m_GHost->NativeStatusPreset( this ) + " | Cycle lobby preset: " + ( m_GHost->m_CurrentGame ? m_GHost->NativeStatusPreset( m_GHost->m_CurrentGame ) : "none" ) );
+	SendChat( player, "Next preset: " + m_GHost->NativeStatusNextPreset( ) + " | Running matches: " + UTIL_ToString( (uint32_t)m_GHost->m_Games.size( ) ) + "/" + UTIL_ToString( m_GHost->m_MaxGames ) );
+	SendChat( player, "Players: " + UTIL_ToString( (uint32_t)NativeEligiblePlayers( ).size( ) ) + ( NativeAIEnabled( ) ? " humans, " + UTIL_ToString( NativeComputerPlayers( ) ) + " computers" : "/" + UTIL_ToString( NativeMaxPlayers( ) ) ) + " | Autostart: " + ( NativeAutoStartPlayers( ) ? UTIL_ToString( NativeAutoStartPlayers( ) ) + ( NativeAIEnabled( ) ? " humans" : " players" ) : "off" ) + " | Votes: " + UTIL_ToString( (uint32_t)m_StartVotes.size( ) ) + "/" + UTIL_ToString( NativeVotesRequired( ) ) );
+	SendChat( player, "State: " + string( m_GameLoading || m_GameLoaded ? "In Game" : m_CountDownStarted ? "Starting" : "Waiting" ) + " | Countdown: " + UTIL_ToString( countdown ) + ( countdown == 1 ? " second" : " seconds" ) + " | Uptime: " + hours + ":" + minutes + ":" + seconds );
+	SendChat( player, "Commands: !vote, !kick <player>, !yes, !status, !help." );
+    if(help)
+    {
+        SendChat(player,"!vote - Vote to start the current lobby early when its human-player requirements are met.");
+        SendChat(player,"!kick <player> - Start or support a vote to remove a player from this match.");
+        SendChat(player,"Kick votes need 70% of eligible human voters (target excluded), and at least two distinct yes votes.");
+        SendChat(player,"!yes - Support the active kick vote. The target cannot vote; membership changes cancel the vote.");
+        SendChat(player,"!status - Show current game and server details. !help - Show available server commands.");
+    }
+	if( diagnostic )
+		SendChat( player, "[HOSTBOT] Refreshes: " + UTIL_ToString( m_GHost->m_NativeRefreshCount ) + " | skipped: " + UTIL_ToString( m_GHost->m_NativeRefreshSkipped ) + " | publication ACK successes/failures: " + UTIL_ToString( m_GHost->m_PublicationRefreshSuccesses ) + "/" + UTIL_ToString( m_GHost->m_PublicationRefreshFailures ) + " | feedback: " + ( m_GHost->m_NativeFeedbackValid ? "fresh" : "unavailable" ) );
+}
+
+bool CBaseGame :: NativeRefresh( )
+{
+	uint64_t now = NativeMonotonicMS( );
+	if( m_NativeRefreshSID != 255 || !m_Potentials.empty( ) || m_Exiting || m_GameLoading || m_GameLoaded || m_CountDownStarted || m_VoteActive || m_SaveGame || !m_EnforceSlots.empty( ) || m_GameState != GAME_PUBLIC ||
+		( m_GHost->m_NativeRefreshStartedMS && now - m_GHost->m_NativeRefreshStartedMS < 10000 ) || m_GHost->m_NativeRefreshSequence == UINT64_MAX )
+	{ ++m_GHost->m_NativeRefreshSkipped; return false; }
+	vector<CGameSlot> original = m_Map->GetSlots( );
+	vector<size_t> free;
+	for( size_t i = 0; i < m_Slots.size( ) && i < original.size( ); ++i )
+		if( m_Slots[i].GetSlotStatus( ) == SLOTSTATUS_OPEN && !m_Slots[i].GetComputer( ) && !m_Slots[i].GetPID( ) &&
+			m_Slots[i].GetTeam( ) < 12 && m_Slots[i].GetColour( ) < 12 && original[i].GetTeam( ) < 12 && original[i].GetColour( ) < 12 && !original[i].GetComputer( ) ) free.push_back( i );
+	// GHost reserves by name, not slot. Keep enough free slots for every absent
+	// held name and absent owner; never borrow that reserved headroom.
+	set<string> pending;
+	for( size_t i = 0; i < m_Reserved.size( ); ++i ) if( !GetPlayerFromName( m_Reserved[i], false ) ) pending.insert( m_Reserved[i] );
+	if( !m_OwnerName.empty( ) && !GetPlayerFromName( m_OwnerName, false ) ) { string owner = m_OwnerName; transform( owner.begin( ), owner.end( ), owner.begin( ), (int(*)(int))tolower ); pending.insert( owner ); }
+	if( free.size( ) <= pending.size( ) ) { ++m_GHost->m_NativeRefreshSkipped; return false; }
+	m_NativeRefreshWave.clear( );
+	for( size_t i = pending.size( ); i < free.size( ); ++i )
+		m_NativeRefreshWave.push_back( make_pair( (unsigned char)free[i], m_Slots[free[i]] ) );
+	m_NativeRefreshSID = m_NativeRefreshWave.back( ).first;
+	m_NativeRefreshSlot = m_NativeRefreshWave.back( ).second;
+	m_NativeRefreshWave.pop_back( );
+	m_NativeRefreshTicks = GetTicks( );
+	m_LastLobbyRefreshTicks = m_NativeRefreshTicks;
+	m_GHost->m_NativeRefreshStartedMS = now;
+	// Only the status byte changes. The event loop keeps processing sockets and
+	// other games while clients see the empty slot closed for one second.
+	m_Slots[m_NativeRefreshSID].SetSlotStatus( SLOTSTATUS_CLOSED );
+	SendAllSlotInfo( );
+	return true;
+}
+
+void CBaseGame :: RestoreNativeRefresh( bool publish, bool advance )
+{
+	if( m_NativeRefreshSID == 255 ) return;
+	unsigned char sid = m_NativeRefreshSID;
+	m_NativeRefreshSID = 255;
+	CGameSlot expected = m_NativeRefreshSlot;
