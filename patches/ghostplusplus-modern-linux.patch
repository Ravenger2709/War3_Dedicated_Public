+string NativeJSONQuote( const string &value )
+{
+	string out = "\"";
+	static const char hex[] = "0123456789abcdef";
+	size_t length = min( value.size( ), (size_t)255 );
+	for( size_t i = 0; i < length; ++i )
+	{
+		unsigned char ch = value[i];
+		if( ch == '"' || ch == '\\' ) { out += '\\'; out += ch; }
+		else if( ch < 32 || ch == 127 ) { out += "\\u00"; out += hex[ch >> 4]; out += hex[ch & 15]; }
+		else if( ch < 0x80 ) out += ch;
+		else
+		{
+			size_t bytes = 0;
+			if( ch >= 0xC2 && ch <= 0xDF ) bytes = 2;
+			else if( ch >= 0xE0 && ch <= 0xEF ) bytes = 3;
+			else if( ch >= 0xF0 && ch <= 0xF4 ) bytes = 4;
+			bool valid = bytes && bytes <= value.size( ) - i;
+			for( size_t j = 1; valid && j < bytes; ++j )
+				if( ( (unsigned char)value[i + j] & 0xC0 ) != 0x80 ) valid = false;
+			if( valid )
+			{
+				unsigned char second = value[i + 1];
+				if( ( ch == 0xE0 && second < 0xA0 ) || ( ch == 0xED && second >= 0xA0 ) ||
+					( ch == 0xF0 && second < 0x90 ) || ( ch == 0xF4 && second > 0x8F ) ) valid = false;
+			}
+			if( !valid ) { out += "\\ufffd"; continue; }
+			// Look ahead at most three bytes past the input limit to recognize a valid sequence.
+			if( bytes > length - i ) break;
+			out.append( value, i, bytes );
+			i += bytes - 1;
+		}
+	}
+	return out + "\"";
