diff --git a/ghost/native_sha256.h b/ghost/native_sha256.h
new file mode 100644
index 0000000..5c2a829
--- /dev/null
+++ b/ghost/native_sha256.h
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 War3 Dedicated contributors.
+// Original streaming SHA-256 implementation of FIPS 180-4. No kernel crypto API.
+#ifndef GHOST_NATIVE_SHA256_H
+#define GHOST_NATIVE_SHA256_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+class NativeSHA256
+{
+    uint32_t m_State[8];
+    uint64_t m_Bytes;
+    unsigned char m_Buffer[64];
+    size_t m_Used;
+    bool m_Done, m_Valid;
+
+    static uint32_t Rotate( uint32_t value, unsigned bits )
+    { return ( value >> bits ) | ( value << ( 32 - bits ) ); }
+
+    void Transform( const unsigned char *block )
+    {
+        static const uint32_t constants[64] = {
+            0x428a2f98U,0x71374491U,0xb5c0fbcfU,0xe9b5dba5U,0x3956c25bU,0x59f111f1U,0x923f82a4U,0xab1c5ed5U,
+            0xd807aa98U,0x12835b01U,0x243185beU,0x550c7dc3U,0x72be5d74U,0x80deb1feU,0x9bdc06a7U,0xc19bf174U,
+            0xe49b69c1U,0xefbe4786U,0x0fc19dc6U,0x240ca1ccU,0x2de92c6fU,0x4a7484aaU,0x5cb0a9dcU,0x76f988daU,
+            0x983e5152U,0xa831c66dU,0xb00327c8U,0xbf597fc7U,0xc6e00bf3U,0xd5a79147U,0x06ca6351U,0x14292967U,
+            0x27b70a85U,0x2e1b2138U,0x4d2c6dfcU,0x53380d13U,0x650a7354U,0x766a0abbU,0x81c2c92eU,0x92722c85U,
+            0xa2bfe8a1U,0xa81a664bU,0xc24b8b70U,0xc76c51a3U,0xd192e819U,0xd6990624U,0xf40e3585U,0x106aa070U,
+            0x19a4c116U,0x1e376c08U,0x2748774cU,0x34b0bcb5U,0x391c0cb3U,0x4ed8aa4aU,0x5b9cca4fU,0x682e6ff3U,
+            0x748f82eeU,0x78a5636fU,0x84c87814U,0x8cc70208U,0x90befffaU,0xa4506cebU,0xbef9a3f7U,0xc67178f2U
+        };
+        uint32_t words[64];
+        for( size_t i = 0; i < 16; ++i )
+            words[i] = (uint32_t)block[4*i] << 24 | (uint32_t)block[4*i+1] << 16 |
+                       (uint32_t)block[4*i+2] << 8 | (uint32_t)block[4*i+3];
+        for( size_t i = 16; i < 64; ++i )
+        {
+            uint32_t x = words[i-15], y = words[i-2];
+            words[i] = words[i-16] + ( Rotate(x,7) ^ Rotate(x,18) ^ (x >> 3) ) +
+                       words[i-7] + ( Rotate(y,17) ^ Rotate(y,19) ^ (y >> 10) );
+        }
+        uint32_t a=m_State[0], b=m_State[1], c=m_State[2], d=m_State[3];
+        uint32_t e=m_State[4], f=m_State[5], g=m_State[6], h=m_State[7];
+        for( size_t i = 0; i < 64; ++i )
+        {
+            uint32_t first = h + ( Rotate(e,6) ^ Rotate(e,11) ^ Rotate(e,25) ) +
+                             ( (e & f) ^ (~e & g) ) + constants[i] + words[i];
+            uint32_t second = ( Rotate(a,2) ^ Rotate(a,13) ^ Rotate(a,22) ) +
+                              ( (a & b) ^ (a & c) ^ (b & c) );
+            h=g; g=f; f=e; e=d+first; d=c; c=b; b=a; a=first+second;
+        }
+        m_State[0]+=a; m_State[1]+=b; m_State[2]+=c; m_State[3]+=d;
+        m_State[4]+=e; m_State[5]+=f; m_State[6]+=g; m_State[7]+=h;
+    }
+
+public:
+    NativeSHA256( ) : m_Bytes(0), m_Used(0), m_Done(false), m_Valid(true)
+    {
+        static const uint32_t initial[8] = { 0x6a09e667U,0xbb67ae85U,0x3c6ef372U,0xa54ff53aU,
+                                            0x510e527fU,0x9b05688cU,0x1f83d9abU,0x5be0cd19U };
+        memcpy(m_State, initial, sizeof m_State);
+    }
+
+    bool Update( const void *input, size_t length )
+    {
+        if( !m_Valid || m_Done || (length && !input) ||
+            (uint64_t)length > ((uint64_t)-1)/8 - m_Bytes )
+        { m_Valid=false; return false; }
+        m_Bytes += (uint64_t)length;
+        const unsigned char *bytes = (const unsigned char *)input;
+        while( length )
+        {
+            size_t take = length < 64-m_Used ? length : 64-m_Used;
+            memcpy(m_Buffer+m_Used, bytes, take);
+            m_Used+=take; bytes+=take; length-=take;
+            if( m_Used==64 ) { Transform(m_Buffer); m_Used=0; }
+        }
+        return true;
+    }
+
+    bool Final( unsigned char *digest )
+    {
+        if( !m_Valid || m_Done || !digest ) { m_Valid=false; return false; }
+        uint64_t bits = m_Bytes * 8;
+        m_Buffer[m_Used++] = 0x80;
+        if( m_Used>56 )
+        { memset(m_Buffer+m_Used,0,64-m_Used); Transform(m_Buffer); m_Used=0; }
+        memset(m_Buffer+m_Used,0,56-m_Used);
+        for( size_t i=0; i<8; ++i ) m_Buffer[56+i]=(unsigned char)(bits >> (56-8*i));
+        Transform(m_Buffer);
+        for( size_t i=0; i<8; ++i )
+            for( size_t j=0; j<4; ++j ) digest[4*i+j]=(unsigned char)(m_State[i] >> (24-8*j));
+        m_Done=true;
+        return true;
+    }
+};
+#endif
