+bool CBaseGame :: ResolveJoinRealm( CPotentialPlayer *potential, CIncomingJoinPlayer *joinPlayer, string &realm )
+{
+	uint32_t tag = joinPlayer->GetHostCounter( ) >> 28;
+	for( vector<CBNET *> :: iterator i = m_GHost->m_BNETs.begin( ); i != m_GHost->m_BNETs.end( ); ++i )
+		if( (*i)->GetHostCounterID( ) == tag ) realm = (*i)->GetServer( );
+	CExternalPublisher *publisher = m_GHost->m_ExternalPublisher;
+	bool reject = false;
+	if( publisher->Enabled( ) && tag != 0 )
+	{
+		if( tag == 15 && m_GHost->m_CurrentGame == this && publisher->Published( m_HostCounter ) &&
+			( joinPlayer->GetHostCounter( ) & 0x0FFFFFFF ) == ( m_HostCounter & 0x0FFFFFFF ) )
+			realm = publisher->Realm( );
+		else if( realm.empty( ) ) reject = true;
+	}
+	if( reject || ( realm.empty( ) && joinPlayer->GetEntryKey( ) != m_EntryKey ) )
+	{
+		if( reject )
+			CONSOLE_Print( "[GAME: " + m_GameName + "] rejected join with invalid external realm or counter" );
+		else
+			CONSOLE_Print( "[GAME: " + m_GameName + "] player [" + joinPlayer->GetName( ) + "|" + potential->GetExternalIPString( ) + "] is trying to join the game over LAN but used an incorrect entry key" );
+		potential->Send( m_Protocol->SEND_W3GS_REJECTJOIN( REJECTJOIN_WRONGPASSWORD ) );
+		potential->SetDeleteMe( true );
+		return false;
+	}
+	return true;
+}
