+#ifndef WIN32
+static uint64_t NativeCatalogLE( const string &data, size_t offset, size_t size )
+{
+    uint64_t value=0;
+    for(size_t i=0;i<size;++i) value|=(uint64_t)(unsigned char)data[offset+i]<<(8*i);
+    return value;
+}
+
+static bool NativeCatalogRead( int fd, string &data )
+{
+    struct stat st;
+    if(fstat(fd,&st) || st.st_size<30 || st.st_size>262144) return false;
+    data.resize((size_t)st.st_size); size_t offset=0;
+    while(offset<data.size())
+    {
+        ssize_t n=pread(fd,&data[offset],data.size()-offset,(off_t)offset);
+        if(n<0 && errno==EINTR) continue;
+        if(n<=0) return false;
+        offset+=n;
+    }
+    return true;
+}
+#endif
