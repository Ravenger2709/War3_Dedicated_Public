+// Inspect all members the native parser can read, regardless of whether optional
+// common.j/blizzard.j are present. Never truncate a member or trust 32-bit size.
+static bool NativeMapMembersWithinLimits( HANDLE archive )
+{
+    static const char *names[] = { "Scripts\\common.j", "Scripts\\blizzard.j",
+        "war3map.j", "scripts\\war3map.j", "war3map.w3e", "war3map.wpm",
+        "war3map.doo", "war3map.w3u", "war3map.w3b", "war3map.w3d",
+        "war3map.w3a", "war3map.w3q", "war3map.w3i" };
+    uint64_t total = 0;
+    bool hasInfo = false, hasScript = false;
+    char buffer[65536];
+    for( size_t i = 0; i < sizeof names / sizeof names[0]; ++i )
+    {
+        HANDLE member;
+        if( !SFileOpenFileEx( archive, names[i], 0, &member ) ) continue;
+        DWORD high = 0;
+        DWORD low = SFileGetFileSize( member, &high );
+        if( high || low == 0xFFFFFFFF || low > NATIVE_MAP_MEMBER_MAX ||
+            total > NATIVE_MAP_MEMBERS_TOTAL_MAX - low )
+        { SFileCloseFile( member ); return false; }
+        uint32_t offset = 0;
+        while( offset < low )
+        {
+            DWORD wanted = min( (uint32_t)sizeof buffer, (uint32_t)( low - offset ) );
+            DWORD got = 0;
+            if( !SFileReadFile( member, buffer, wanted, &got, NULL ) || got != wanted )
+            { SFileCloseFile( member ); return false; }
+            offset += got;
+        }
+        SFileCloseFile( member );
+        if( i == 12 && low ) hasInfo = true;
+        if( ( i == 2 || i == 3 ) && low ) hasScript = true;
+        total += low;
+    }
+    return hasInfo && hasScript;
+}
