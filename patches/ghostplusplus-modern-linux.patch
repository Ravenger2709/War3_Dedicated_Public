+#ifndef WIN32
+// The caller owns root; this walker owns only its duplicate.
+static bool NativeCgroupWalk( int root, const string &membership, uint64_t &headroom )
+{
+    headroom=0;
+    if(membership.empty() || membership[0]!='/') return false;
+    int dir=fcntl(root,F_DUPFD_CLOEXEC,3);
+    if(dir<0) return false;
+    uint64_t minimum=std::numeric_limits<uint64_t>::max(); bool finite=false, ok=true;
+    size_t pos=1;
+    while(pos<membership.size())
+    {
+        size_t end=membership.find('/',pos);
+        string part=membership.substr(pos,end==string::npos?string::npos:end-pos);
+        if(part.empty()||part=="."||part==".."||part.find_first_of("\r\n")!=string::npos) { ok=false; break; }
+        int next=openat(dir,part.c_str(),O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW);
+        if(next<0) { ok=false; break; }
+        close(dir); dir=next;
+        string value;
+        if(!NativeCgroupText(dir,"memory.max",64,value)) { ok=false; break; }
+        if(value!="max\n")
+        {
+            uint64_t maxvalue=0,current=0;
+            if(!NativeCgroupUInt(value,maxvalue) || !maxvalue ||
+               !NativeCgroupText(dir,"memory.current",64,value) || !NativeCgroupUInt(value,current) || current>maxvalue)
+            { ok=false; break; }
+            minimum=min(minimum,maxvalue-current); finite=true;
+        }
+        if(end==string::npos) { pos=membership.size(); break; }
+        pos=end+1;
+    }
+    if(ok && (!finite || !NativeCgroupContainsSelf(dir))) ok=false;
+    close(dir);
+    if(!ok) return false;
+    headroom=minimum; return true;
+}
