+// Bind the immutable manifest inode to the exact producer digest. This is
+// separate from envelope/schema validation and fails closed on missing AF_ALG.
+bool NativePreloadManifestDigestMatches( int manifestFD, const string &expected )
+{
+#ifndef WIN32
+    struct stat st;
+    if(expected.size()!=64 || expected.find_first_not_of("0123456789abcdef")!=string::npos ||
+       fstat(manifestFD,&st) || st.st_size<30 || st.st_size>262144 ||
+       !NativeManifestFD(manifestFD,(uint64_t)st.st_size)) return false;
+    unsigned char digest[32];
+    for(size_t i=0;i<32;++i)
+    {
+        char a=expected[2*i], b=expected[2*i+1];
+        unsigned x=a<='9'?a-'0':a-'a'+10, y=b<='9'?b-'0':b-'a'+10;
+        digest[i]=(unsigned char)((x<<4)|y);
+    }
+    return NativeManifestHashFD(manifestFD,(uint64_t)st.st_size,digest);
+#else
+    return false;
+#endif
+}
