+CNativeStartupCatalog *NativeBuildBoundStartupCatalog( CGHost *host, int manifestFD, const string &digest )
+{
+#ifndef WIN32
+    if(!host || host->m_NativeAdmissionCatalog || !host->m_LifecycleValid || host->m_LifecycleGeneration.size()!=32 ||
+       host->m_LifecycleGeneration.find_first_not_of("0123456789abcdef")!=string::npos) return NULL;
+    int fd=fcntl(manifestFD,F_DUPFD_CLOEXEC,3);
+    if(fd<0) return NULL;
+    CNativeStartupCatalog *catalog=NULL;
+    try
+    {
+        if(NativePreloadManifestDigestMatches(fd,digest)) catalog=NativeBuildStartupCatalog(host,fd);
+        if(catalog)
+        {
+            catalog->m_ManifestDigest=digest; catalog->m_SessionGeneration=host->m_LifecycleGeneration;
+            host->m_NativeAdmissionCatalog=catalog;
+            host->m_NativeCatalogOnly=true; host->m_AutoHostGameName.clear();
+        }
+    }
+    catch(...) { delete catalog; catalog=NULL; }
