+void CGHost :: UpdateNativeFeedback( bool force )
+{
+	if( !force && GetTicks( ) - m_LastNativeFeedbackTicks < 1000 ) return;
+	m_LastNativeFeedbackTicks = GetTicks( );
+	m_NativeOnline = m_NativeFeedbackValid = false;
+	m_NativeLastAckMS = m_PublicationRefreshCount = m_PublicationRefreshSuccesses = m_PublicationRefreshFailures = 0;
+#ifndef WIN32
+	map<string,uint64_t> feedback;
+	if( !NativeReadFeedback( m_ExternalStatusPath, feedback ) ) return;
+	m_NativeFeedbackValid = true;
+	// In-game sessions normally have no lobby announcement. Publication state
+	// must never substitute for (or suppress) live authentication/relay health.
+	m_NativeOnline = feedback["connected"] && feedback["authenticated"] && feedback["relay_healthy"];
+	m_NativeLastAckMS = feedback["last_ack_monotonic_ms"];
+	m_PublicationRefreshCount = feedback["publication_refresh_count"];
+	m_PublicationRefreshSuccesses = feedback["publication_refresh_successes"];
+	m_PublicationRefreshFailures = feedback["publication_refresh_failures"];
+#endif
+}
