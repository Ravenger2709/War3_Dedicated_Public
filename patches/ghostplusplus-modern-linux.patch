+void CNativeStartupCatalog :: FinishAdmission( CGHost *host )
+{
+    if( host==m_Owner ) { m_StagedID.clear(); m_StagedIndex=0; }
+}
+
+// Validate a map and settings without mutating host, pending, or active games.
+bool CGHost :: ValidateNativeNextPreset( CMap *map, const NativeNextPreset &s )
+{
+    if( s.GameName.empty( ) || s.GameName.size( ) > 24 ) return false;
+    for( size_t i = 0; i < s.GameName.size( ); ++i )
+        if( (unsigned char)s.GameName[i] < 32 || s.GameName[i] == '=' || s.GameName[i] == '[' || s.GameName[i] == ']' ) return false;
+    if( !map || map->m_GHost != this || !map->GetValid( ) || m_Exiting || m_ExitingNice ||
+        s.MaxPlayers < 2 || s.MaxPlayers > 12 || s.MaxPlayers > map->GetMapNumPlayers( ) ||
+        s.MaxPlayers > map->GetSlots( ).size( ) || s.DefaultAutoStartPlayers < 2 || s.DefaultAutoStartPlayers > 12 ||
+        ( s.AutoStartEnabled && s.DefaultAutoStartPlayers > s.MaxPlayers ) || s.CountDownSeconds > 60 ||
+        s.VoteRequiredPercent < 1 || s.VoteRequiredPercent > 100 ||
+        s.VoteTimeout < 5 || s.VoteTimeout > 600 || s.VoteCooldown > 600 ||
+        s.LobbyRefreshInterval < 10 || s.LobbyRefreshInterval > 3600 || s.LobbyAISkill > 2 ||
+        s.LobbyMinHumans < 1 || s.LobbyMinHumans > s.MaxPlayers ||
+        s.VoteMinPlayers < 1 || s.VoteMinPlayers > s.MaxPlayers ||
+        ( s.LobbyAISupported ? s.LobbyAITarget < 2 || s.LobbyAITarget > s.MaxPlayers :
+          s.LobbyAITarget != 0 || s.LobbyMinHumans < 2 ) ||
+        ( !s.LobbyAITarget && s.LobbyMinHumans < 2 ) ||
+        ( s.VoteMinPlayers < 2 && !( s.LobbyAISupported && s.LobbyAITarget >= 2 && s.LobbyMinHumans == 1 ) ) )
+        return false;
+
+    // Reject missing local map data even if synthetic metadata is complete.
+    if( !map->GetMapLocalPath( ).empty( ) && map->GetMapData( )->empty( ) ) return false;
+
+    // resolve_preset checks actual open-human capacity, including preset computers.
+    vector<CGameSlot> presetSlots = map->GetSlots( );
+    uint32_t humans = 0, computers = 0;
+    for( size_t i = 0; i < presetSlots.size( ); ++i )
+    {
+        if( presetSlots[i].GetComputer( ) ) ++computers;
+        else if( presetSlots[i].GetSlotStatus( ) == SLOTSTATUS_OPEN ) ++humans;
+    }
+    uint32_t capacity = s.LobbyAISupported ? s.MaxPlayers :
+        s.MaxPlayers > computers ? s.MaxPlayers - computers : 0;
+    uint32_t humanLimit = min( humans, capacity );
+    if( s.VoteMinPlayers > humanLimit ||
+        ( s.AutoStartEnabled && s.DefaultAutoStartPlayers > humanLimit ) ) return false;
+
+    if( m_AutoHostMatchMaking ) return false;
+    if( s.LobbyAISupported && s.LobbyAITarget >= 2 )
+    {
+        vector<CGameSlot> slots = map->GetSlots( );
+        set<unsigned char> colours, teams;
+        uint32_t humanSlots = 0;
+        if( slots.size( ) > 12 ) return false;
+        for( size_t i = 0; i < slots.size( ); ++i )
+        {
+            CGameSlot &slot = slots[i];
+            if( slot.GetTeam( ) >= 12 || slot.GetColour( ) >= 12 ) continue;
+            if( !colours.insert( slot.GetColour( ) ).second ) return false;
+            teams.insert( slot.GetTeam( ) );
+            if( !slot.GetComputer( ) ) ++humanSlots;
+        }
+        if( teams.size( ) < 2 || teams.size( ) > map->GetMapNumTeams( ) ||
+            s.LobbyAITarget > min( humanSlots, s.MaxPlayers ) ) return false;
+    }
+
+    return true;
+}
+
+// Synchronous event-loop transaction. No callbacks are made after the commit starts.
+bool CGHost :: ApplyNativeNextPreset( CMap *map, const NativeNextPreset &s )
+{
+    if( m_NativeCatalogOnly && !m_NativeCatalogStaging ) return false;
