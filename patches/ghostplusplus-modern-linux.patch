+            for(size_t j=0;j<15;++j) e.values[j]=(uint32_t)NativeCatalogLE(data,cursor+50+4*j,4);
+            cursor+=110; e.id=data.substr(cursor,idlen); cursor+=idlen; e.name=data.substr(cursor,namelen); cursor+=namelen;
