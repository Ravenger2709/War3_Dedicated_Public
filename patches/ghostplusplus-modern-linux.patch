+// Conservative admission only; cgroup usage can change after this snapshot.
+// Count sealed inputs and resident catalog data, default/autohost, admin plus
+// admin game, active/current games and old/new pending maps, plus load buffers.
+// Sizes are bounded before arithmetic, so the sums below cannot overflow.
+bool NativePreloadAdmissionBudget( const vector<uint64_t> &sizes, uint64_t defaultSize,
+    uint64_t adminSize, uint32_t maxGames, uint64_t current, uint64_t limit, uint64_t &required )
+{
+    required = 0;
+    if( sizes.empty( ) || sizes.size( ) > 32 || !defaultSize || defaultSize > NATIVE_MAP_FILE_MAX ||
+        adminSize > NATIVE_MAP_FILE_MAX || maxGames < 1 || maxGames > 5 || !limit || current > limit ) return false;
+    uint64_t total = 128ULL * 1024 * 1024;
+    uint64_t largest = defaultSize;
+    for( size_t i = 0; i < sizes.size( ); ++i )
+    {
+        if( !sizes[i] || sizes[i] > NATIVE_MAP_FILE_MAX ) return false;
+        total += 2 * sizes[i];
+        largest = max( largest, sizes[i] );
+    }
+    total += 2 * defaultSize + 2 * adminSize + largest * ( maxGames + 3 );
+    required = total;
+    return total <= 512ULL * 1024 * 1024 && total <= limit - current;
+}
