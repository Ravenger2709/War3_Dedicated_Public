+#ifndef WIN32
+// Returns -1 for invalid/error, 0 absent, 1 verified; sync before accepting.
+static int NativeIPCRead( int dir, const string &name, string &out )
+{
+    int fd=openat(dir,name.c_str(),O_RDONLY|O_NONBLOCK|O_NOFOLLOW|O_CLOEXEC);
+    if(fd<0) return errno==ENOENT ? 0 : -1;
+    struct stat a,b,named;
+    bool ok=!fstat(fd,&a) && S_ISREG(a.st_mode) && a.st_uid==geteuid() && (a.st_mode&07777)==0600 &&
+        a.st_nlink==1 && a.st_size>0 && a.st_size<=512;
+    out.clear(); char bytes[512];
+    while(ok)
+    {
+        ssize_t n=read(fd,bytes,sizeof bytes);
+        if(n<0 && errno==EINTR) continue;
+        if(n<0) { ok=false; break; }
+        if(n==0) break;
+        try { out.append(bytes,n); } catch(...) { close(fd); return -1; }
+        if(out.size()>512) ok=false;
+    }
+    if(ok && fsync(fd)) ok=false;
+    if(ok && (fstat(fd,&b) || fstatat(dir,name.c_str(),&named,AT_SYMLINK_NOFOLLOW) ||
+        a.st_dev!=b.st_dev || a.st_ino!=b.st_ino || a.st_size!=b.st_size || a.st_mode!=b.st_mode ||
+        a.st_uid!=b.st_uid || a.st_nlink!=b.st_nlink || a.st_mtim.tv_sec!=b.st_mtim.tv_sec ||
+        a.st_mtim.tv_nsec!=b.st_mtim.tv_nsec || a.st_ctim.tv_sec!=b.st_ctim.tv_sec || a.st_ctim.tv_nsec!=b.st_ctim.tv_nsec ||
+        b.st_dev!=named.st_dev || b.st_ino!=named.st_ino || b.st_nlink!=named.st_nlink ||
+        b.st_mode!=named.st_mode || b.st_uid!=named.st_uid || b.st_size!=named.st_size || out.size()!=(size_t)a.st_size)) ok=false;
+    close(fd); return ok ? 1 : -1;
+}
+
+static bool NativeIPCStable( const string &directory, int held )
+{
+    int current=NativeStatusDirectory(directory); struct stat a,b;
+    bool ok=current>=0 && !fstat(held,&a) && !fstat(current,&b) && a.st_dev==b.st_dev && a.st_ino==b.st_ino;
+    if(current>=0) close(current);
+    return ok;
+}
+
+static bool NativeIPCWrite( const string &directory, int dir, const string &name, const string &payload )
+{
+    string id;
+    if(!NativeRandomID(id)) return false;
+    string temporary=".preload-"+id+".tmp";
+    int fd=openat(dir,temporary.c_str(),O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);
+    if(fd<0) return false;
+    bool ok=!fchmod(fd,0600); size_t offset=0;
+    while(ok && offset<payload.size())
+    {
+        ssize_t n=write(fd,payload.data()+offset,payload.size()-offset);
+        if(n<0 && errno==EINTR) continue;
+        if(n<=0) { ok=false; break; }
+        offset+=n;
+    }
+    if(ok && fsync(fd)) ok=false;
+    if(close(fd)) ok=false;
+    if(ok && !NativeIPCStable(directory,dir)) ok=false;
+    bool renamed=false;
+    if(ok) { if(syscall(SYS_renameat2,dir,temporary.c_str(),dir,name.c_str(),RENAME_NOREPLACE)) ok=false; else renamed=true; }
+    if(ok && fsync(dir)) ok=false;
+    if(ok && !NativeIPCStable(directory,dir)) ok=false;
+    string observed;
+    if(ok && (NativeIPCRead(dir,name,observed)!=1 || observed!=payload)) ok=false;
+    if(!renamed) unlinkat(dir,temporary.c_str(),0);
+    return ok;
+}
+#endif
