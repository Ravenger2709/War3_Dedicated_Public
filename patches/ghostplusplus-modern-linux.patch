+bool NativePreloadPayloadBudget( const vector<uint64_t> &uniqueMapSizes, uint64_t defaultMapSize, uint32_t maxGames, uint64_t &required )
+{
+    required = 0;
+    if( uniqueMapSizes.empty( ) || uniqueMapSizes.size( ) > 32 || !defaultMapSize || defaultMapSize > NATIVE_MAP_FILE_MAX || maxGames < 1 || maxGames > 5 ) return false;
+    uint64_t total = 128ULL * 1024 * 1024; // conservative explicit temporary load buffers
+    uint64_t largest = defaultMapSize;
+    for( size_t i = 0; i < uniqueMapSizes.size( ); ++i )
+    {
+        uint64_t size = uniqueMapSizes[i];
+        if( !size || size > NATIVE_MAP_FILE_MAX ) return false;
+        total += size;
+        largest = max( largest, size );
+    }
+    // Default + autohost; active games, lobby, and old+new pending snapshots.
+    total += 2 * defaultMapSize + largest * ( maxGames + 3 );
+    required = total;
+    return total <= 512ULL * 1024 * 1024;
+}
