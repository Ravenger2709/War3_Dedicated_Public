+unsigned char CBaseGame :: PrepareNativeAIJoin( CGameSlot &computer, CGameSlot &empty, unsigned char team )
+{
+	if( !NativeAIEnabled( ) || m_Exiting || m_GameLoading || m_GameLoaded || NativeEligiblePlayers( ).size( ) >= NativeMaxPlayers( ) ) return 255;
+	for( map<unsigned char,pair<CGameSlot,CGameSlot> >::iterator i = m_NativeAISlots.begin( ); i != m_NativeAISlots.end( ); ++i )
+	{
+		if( i->first >= m_Slots.size( ) || m_Slots[i->first].GetByteArray( ) != i->second.second.GetByteArray( ) ) continue;
+		if( team != 255 && m_Slots[i->first].GetTeam( ) != team ) continue;
+		computer = i->second.second;
+		empty = i->second.first;
+		m_Slots[i->first] = empty;
+		return i->first;
+	}
+	return 255;
