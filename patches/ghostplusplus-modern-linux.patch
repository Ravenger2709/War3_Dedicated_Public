+string CGHost :: NativeStatusPreset( CBaseGame *game ) const
+{
+    uint32_t index=0;
+    if(!game || !m_NativeAdmissionCatalog || !game->NativeCatalogIndex(index) ||
+       game->NativeCatalogDigest()!=m_NativeAdmissionCatalog->Digest()) return "unavailable";
