+			else ReleaseNativeAI( sid );
+			return;
+		}
+		m_NativeAISlots.erase( sid );
+		m_NativeAIBlockedSlots.erase( sid );
+	}
+	if( accepted ) ReconcileNativeAI( false );
+}
