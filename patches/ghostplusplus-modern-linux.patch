+// Walk from root, rejecting symlinks and dot components. Only the final
+// directory must be private: ancestors such as /tmp may legitimately be shared.
+static int ExternalPublishDirectory( const string &path )
+{
+	if( path.empty( ) || path[0] != '/' || path.size( ) > 4096 )
+		return -1;
+	int fd = open( "/", O_RDONLY | O_DIRECTORY | O_CLOEXEC );
+	size_t begin = 1;
+	while( fd >= 0 && begin < path.size( ) )
+	{
+		size_t end = path.find( '/', begin );
+		string part = path.substr( begin, end == string::npos ? string::npos : end - begin );
+		if( part.empty( ) || part == "." || part == ".." ) { close( fd ); return -1; }
+		int next = openat( fd, part.c_str( ), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC );
+		close( fd );
+		fd = next;
+		if( end == string::npos ) break;
+		begin = end + 1;
+		if( begin == path.size( ) ) { if( fd >= 0 ) close( fd ); return -1; }
+	}
+	struct stat st;
+	if( fd >= 0 && ( fstat( fd, &st ) || st.st_uid != geteuid( ) || ( st.st_mode & 07777 ) != 0700 ) )
+	{ close( fd ); return -1; }
+	return fd;
+}
+#endif
+
+CExternalPublisher :: CExternalPublisher( string path, string realm, string hostName ) :
+	m_Directory( -1 ), m_Path( path ), m_Realm( realm ), m_HostName( hostName ),
+	m_Generation( 0 ), m_Sequence( 0 ), m_IntentDevice( 0 ), m_IntentInode( 0 ), m_Counter( 0 ), m_LastTicks( 0 ), m_StartedTicks( 0 ), m_LastRetryTicks( 0 ), m_RetryDelay( 1000 ), m_Valid( true ), m_Published( false ), m_IntentOwned( false )
+{
+	if( !Enabled( ) ) return;
+	m_Valid = false;
+#ifndef WIN32
+	if( path.find( '\0' ) != string::npos || realm.empty( ) || realm.size( ) > 255 || hostName.empty( ) || hostName.size( ) > 31 ) return;
+	for( size_t i = 0; i < realm.size( ); ++i ) if( (unsigned char)realm[i] < 32 || (unsigned char)realm[i] == 127 ) return;
+	for( size_t i = 0; i < hostName.size( ); ++i ) if( (unsigned char)hostName[i] < 32 || (unsigned char)hostName[i] == 127 ) return;
+	size_t slash = path.rfind( '/' );
+	if( slash == string::npos || slash == 0 ) return;
+	m_Name = path.substr( slash + 1 );
+	if( m_Name.empty( ) || m_Name.size( ) > 128 || m_Name == "." || m_Name == ".." ) return;
+	m_Directory = ExternalPublishDirectory( path.substr( 0, slash ) );
+	if( m_Directory < 0 || flock( m_Directory, LOCK_EX | LOCK_NB ) ) return;
+	struct timespec stamp;
+	if( clock_gettime( CLOCK_MONOTONIC, &stamp ) ) return;
+	m_Generation = ( (uint64_t)stamp.tv_sec * 1000000000ULL + stamp.tv_nsec ) ^ ( (uint64_t)getpid( ) << 32 );
+	if( !m_Generation ) m_Generation = 1;
+	// Replace stale state before any lobby can be created, including idle runs.
+	CBNETProtocol protocol;
+	m_Valid = Write( false, 0, protocol.SEND_SID_STOPADV( ) );
+#endif
+}
+
+CExternalPublisher :: ~CExternalPublisher( )
+{
+	if( m_Generation ) Stop( m_Counter, true );
+#ifndef WIN32
+	if( m_Directory >= 0 ) close( m_Directory );
+#endif
+}
+
+bool CExternalPublisher :: Write( bool publish, uint32_t counter, const BYTEARRAY &packet )
+{
+#ifndef WIN32
+	if( m_Directory < 0 || !m_Generation || packet.empty( ) || packet.size( ) > 1024 || m_Sequence == UINT64_MAX ) return false;
+	// Revalidate the public path as well as the held directory descriptor.
+	int current = ExternalPublishDirectory( m_Path.substr( 0, m_Path.rfind( '/' ) ) );
+	struct stat held, now, target;
+	bool same = current >= 0 && !fstat( current, &now ) && !fstat( m_Directory, &held ) && now.st_dev == held.st_dev && now.st_ino == held.st_ino;
+	if( current >= 0 ) close( current );
+	if( !same ) return false;
+	if( !fstatat( m_Directory, m_Name.c_str( ), &target, AT_SYMLINK_NOFOLLOW ) )
+	{
+		if( !S_ISREG( target.st_mode ) || target.st_uid != geteuid( ) || ( target.st_mode & 07777 ) != 0600 || target.st_nlink != 1 || target.st_size > 4096 ) return false;
+	}
+	else if( errno != ENOENT ) return false;
+	static const char hex[] = "0123456789abcdef";
+	string encoded;
+	for( size_t i = 0; i < packet.size( ); ++i ) { encoded += hex[packet[i] >> 4]; encoded += hex[packet[i] & 15]; }
+	string json = "{\"version\":1,\"pid\":" + UTIL_ToString( (uint32_t)getpid( ) ) +
+		",\"generation\":" + UTIL_ToString( m_Generation ) + ",\"sequence\":" + UTIL_ToString( m_Sequence + 1 ) +
+		",\"host_counter\":" + UTIL_ToString( counter & 0x0FFFFFFF ) +
+		",\"operation\":\"" + ( publish ? "publish" : "unpublish" ) + "\",\"packet_hex\":\"" + encoded + "\"}\n";
+	if( json.size( ) > 4096 ) return false;
+	string temporary = "." + m_Name + "." + UTIL_ToString( (uint32_t)getpid( ) ) + "." + UTIL_ToString( m_Sequence + 1 ) + ".tmp";
+	int fd = openat( m_Directory, temporary.c_str( ), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600 );
+	if( fd < 0 ) return false;
+	bool ok = !fchmod( fd, 0600 );
+	size_t offset = 0;
+	while( ok && offset < json.size( ) )
+	{
+		ssize_t written = write( fd, json.data( ) + offset, json.size( ) - offset );
+		if( written < 0 && errno == EINTR ) continue;
+		if( written <= 0 ) { ok = false; break; }
+		offset += written;
+	}
+	if( ok && fsync( fd ) ) ok = false;
+	if( close( fd ) ) ok = false;
+	bool renamed = false;
+	if( ok )
+	{
+		if( renameat( m_Directory, temporary.c_str( ), m_Directory, m_Name.c_str( ) ) ) ok = false;
+		else { renamed = true; ++m_Sequence; } // visible even if directory fsync subsequently fails
+	}
+	if( renamed )
+	{
+		// Retain the exact inode we wrote so an inaccessible old directory cannot
+		// revive its stale advertisement when the pathname is restored.
+		struct stat published;
+		m_IntentOwned = !fstatat( m_Directory, m_Name.c_str( ), &published, AT_SYMLINK_NOFOLLOW ) &&
+			S_ISREG( published.st_mode ) && published.st_uid == geteuid( ) && ( published.st_mode & 07777 ) == 0600 && published.st_nlink == 1;
+		if( m_IntentOwned ) { m_IntentDevice = published.st_dev; m_IntentInode = published.st_ino; }
+		else ok = false;
+	}
+	if( ok && fsync( m_Directory ) ) ok = false;
+	// A replaced pathname must not make a successful write to the old inode valid.
+	if( ok )
+	{
+		int current = ExternalPublishDirectory( m_Path.substr( 0, m_Path.rfind( '/' ) ) );
+		struct stat now, held;
+		ok = current >= 0 && !fstat( current, &now ) && !fstat( m_Directory, &held ) && now.st_dev == held.st_dev && now.st_ino == held.st_ino;
+		if( current >= 0 ) close( current );
+	}
+	if( !renamed ) unlinkat( m_Directory, temporary.c_str( ), 0 );
+	return ok;
+#else
+	return false;
+#endif
+}
+
+void CExternalPublisher :: Failed( )
+{
+#ifndef WIN32
+	// Invalidate only our own last intent; do not follow or remove a substituted
+	// target. The held directory FD remains usable even when its path moved.
+	struct stat current;
+	if( m_IntentOwned && !fstatat( m_Directory, m_Name.c_str( ), &current, AT_SYMLINK_NOFOLLOW ) &&
+		S_ISREG( current.st_mode ) && current.st_uid == geteuid( ) && ( current.st_mode & 07777 ) == 0600 &&
+		current.st_nlink == 1 && (uint64_t)current.st_dev == m_IntentDevice && (uint64_t)current.st_ino == m_IntentInode )
+	{
+		if( !unlinkat( m_Directory, m_Name.c_str( ), 0 ) ) fsync( m_Directory );
+	}
+#endif
+	m_IntentOwned = false;
+	m_Valid = false;
+	m_Published = false;
+	m_LastRetryTicks = GetTicks( );
+	m_RetryDelay = 1000;
+}
+
+void CExternalPublisher :: Retry( )
+{
+	if( !Enabled( ) || m_Valid || !m_Generation || GetTicks( ) - m_LastRetryTicks < m_RetryDelay ) return;
+	m_LastRetryTicks = GetTicks( );
+	// Always revoke the old advertisement before any current lobby republishes.
+	// Never retain a CMap pointer or retry a stale publish across lobby changes.
+	CBNETProtocol protocol;
+	if( Write( false, m_Counter, protocol.SEND_SID_STOPADV( ) ) )
+	{
+		m_Valid = true;
+		m_Published = false;
+		m_RetryDelay = 1000;
+		CONSOLE_Print( "[GHOST] external publication recovered" );
+	}
+	else
+		m_RetryDelay = m_RetryDelay >= 15000 ? 30000 : m_RetryDelay * 2;
+}
+
+void CExternalPublisher :: Publish( CMap *map, string gameName, uint32_t counter, bool reconnect, uint32_t gameType )
+{
+	if( !Enabled( ) || !m_Valid ) return;
+	counter &= 0x0FFFFFFF;
+	if( m_Published && m_Counter == counter && GetTicks( ) - m_LastTicks < 3000 ) return;
+	if( !m_Published || m_Counter != counter ) m_StartedTicks = GetTicks( );
+	CBNETProtocol protocol;
+	if( !gameType ) gameType = map->GetMapGameType( ) | MAPGAMETYPE_UNKNOWN0;
+	BYTEARRAY width = reconnect ? UTIL_CreateByteArray( (uint16_t)1984, false ) : map->GetMapWidth( );
+	BYTEARRAY height = reconnect ? UTIL_CreateByteArray( (uint16_t)1984, false ) : map->GetMapHeight( );
+	BYTEARRAY packet = protocol.SEND_SID_STARTADVEX3( 16, UTIL_CreateByteArray( gameType, false ), map->GetMapGameFlags( ), width, height, gameName, m_HostName, ( GetTicks( ) - m_StartedTicks ) / 1000, map->GetMapPath( ), map->GetMapCRC( ), map->GetMapSHA1( ), counter | 0xF0000000 );
+	if( !Write( true, counter, packet ) ) { Failed( ); CONSOLE_Print( "[GHOST] external publication write failed" ); return; }
+	m_Counter = counter;
+	m_Published = true;
+	m_LastTicks = GetTicks( );
+}
+
+void CExternalPublisher :: Stop( uint32_t counter, bool force )
+{
+	if( !Enabled( ) || !m_Valid || ( !force && ( !m_Published || m_Counter != ( counter & 0x0FFFFFFF ) ) ) ) return;
+	CBNETProtocol protocol;
+	if( !Write( false, counter, protocol.SEND_SID_STOPADV( ) ) ) { Failed( ); CONSOLE_Print( "[GHOST] external publication stop failed" ); }
+	m_Published = false;
+}
