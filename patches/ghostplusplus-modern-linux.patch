+bool CNativeStartupCatalog :: HandleRequest( CGHost *host, const string &directory, const string &requestID )
+{
+#ifndef WIN32
+    if(m_IPCBlocked || m_IPCDirectoryFD<0 || directory!=m_IPCDirectory || !host || host!=m_Owner || m_ManifestDigest.size()!=64 || m_SessionGeneration.size()!=32 ||
+       host->m_LifecycleGeneration!=m_SessionGeneration || !host->m_LifecycleValid || requestID.size()!=32 ||
+       requestID.find_first_not_of("0123456789abcdef")!=string::npos) return false;
+    int dir=-1; bool stagedByThis=false;
+    try
+    {
+    dir=NativeStatusDirectory(directory);
+    if(dir<0) { if(!m_IPCBlocked) host->CountNativeRotationError( ); m_IPCBlocked=true; host->m_Enabled=false; return false; }
+    struct stat pinned, opened;
+    bool ok=!fstat(m_IPCDirectoryFD,&pinned) && !fstat(dir,&opened) && pinned.st_dev==opened.st_dev &&
+        pinned.st_ino==opened.st_ino && NativeIPCStable(directory,m_IPCDirectoryFD) && NativeIPCStable(directory,dir);
+    string payload;
+    string request="request-"+requestID+".ready", claim="claim-"+requestID+".ready", ack="ack-"+requestID+".ready";
+    int read=ok?NativeIPCRead(dir,request,payload):-1;
+    if(read==0) { close(dir); return true; }
+    if(read!=1 || fsync(dir) || !NativeIPCStable(directory,dir)) ok=false;
+    string prefix="version=1\nsession_generation="+m_SessionGeneration+"\nmanifest_sha256="+m_ManifestDigest+
+        "\nrequest_id="+requestID+"\nindex=";
+    unsigned index=0;
+    if(ok)
+    {
+        if(payload.compare(0,prefix.size(),prefix) || payload.size()<=prefix.size()+1 || payload[payload.size()-1]!='\n') ok=false;
+        else
+        {
+            string number=payload.substr(prefix.size(),payload.size()-prefix.size()-1);
+            if(number.empty() || number.size()>2 || (number.size()>1 && number[0]=='0')) ok=false;
+            for(size_t i=0;ok && i<number.size();++i)
+                if(number[i]<'0'||number[i]>'9') ok=false; else index=index*10+number[i]-'0';
+            if(index>=32) ok=false;
+        }
+    }
+    string claimed, recorded; int c=ok?NativeIPCRead(dir,claim,claimed):-1, a=ok?NativeIPCRead(dir,ack,recorded):-1;
+    if(c<0 || a<0 || (c==1 && claimed!=payload) || (a==1 && c!=1)) ok=false;
+    if(ok && a==1)
+    {
+        if(recorded!=payload+"status=staged\n" && recorded!=payload+"status=rejected\n" && recorded!=payload+"status=uncertain\n") ok=false;
+        else if(recorded==payload+"status=uncertain\n") ok=false;
+    }
+    else if(ok && c==1)
+    {
+        // A durable claim without an ACK is ambiguous after a crash; never restage.
+        NativeIPCWrite(directory,dir,ack,payload+"status=uncertain\n"); ok=false;
+    }
+    else if(ok)
+    {
+        if(!NativeIPCWrite(directory,dir,claim,payload)) ok=false;
+        else
+        {
+            m_DurableContext=true;
+            int staged=Stage(host,requestID,index);
+            m_DurableContext=false; stagedByThis=(staged==1);
+            string status=staged==1 ? "staged" : "rejected";
+            string stagedID=staged==1 ? requestID : string();
+            if(!NativeIPCWrite(directory,dir,ack,payload+"status="+status+"\n"))
+            {
+                if(staged==1) { delete host->m_NativePendingMap; host->m_NativePendingMap=NULL;
+                    delete host->m_NativePendingPreset; host->m_NativePendingPreset=NULL; host->m_NativePendingCatalogID.clear(); host->m_NativePendingCatalogDigest.clear(); }
+                ok=false;
+            }
+            else if(staged==1) { m_StagedID.swap(stagedID); m_StagedIndex=index; }
+            else host->CountNativeRotationError( );
+        }
+    }
+    close(dir); dir=-1;
+    if(!ok) { if(!m_IPCBlocked) host->CountNativeRotationError( ); m_IPCBlocked=true; host->m_Enabled=false; }
+    return ok;
+    }
+    catch(...)
+    {
+        m_DurableContext=false;
+        if(dir>=0) close(dir);
+        if(stagedByThis) { delete host->m_NativePendingMap; host->m_NativePendingMap=NULL;
+            delete host->m_NativePendingPreset; host->m_NativePendingPreset=NULL; host->m_NativePendingCatalogID.clear(); host->m_NativePendingCatalogDigest.clear(); }
+        if(!m_IPCBlocked) host->CountNativeRotationError( ); m_IPCBlocked=true; host->m_Enabled=false; return false;
+    }
+#else
+    return false;
+#endif
+}
+
+// One bounded mailbox keeps event-loop work independent of historical request
+// count. The immutable request, claim and ACK files are retained separately.
+bool CNativeStartupCatalog :: PollIPC( CGHost *host )
+{
+#ifndef WIN32
+    if(m_IPCBlocked || !host || host!=m_Owner || m_IPCDirectoryFD<0) return false;
+    bool ok=true; string payload, request, ack; struct stat before, after;
+    try
+    {
+        if(!NativeIPCStable(m_IPCDirectory,m_IPCDirectoryFD)) ok=false;
+        int r=ok ? NativeIPCRead(m_IPCDirectoryFD,"next.ready",payload) : -1;
+        if(r==0) return true;
+        if(r!=1 || fstatat(m_IPCDirectoryFD,"next.ready",&before,AT_SYMLINK_NOFOLLOW)) ok=false;
+        string prefix="version=1\nsession_generation="+m_SessionGeneration+"\nmanifest_sha256="+m_ManifestDigest+"\nrequest_id=";
+        string id;
+        if(ok)
+        {
+            if(payload.compare(0,prefix.size(),prefix) || payload.size()<prefix.size()+32+8) ok=false;
+            else { id=payload.substr(prefix.size(),32); if(id.find_first_not_of("0123456789abcdef")!=string::npos) ok=false; }
+        }
+        if(ok && (NativeIPCRead(m_IPCDirectoryFD,"request-"+id+".ready",request)!=1 || request!=payload ||
+                  !NativeIPCStable(m_IPCDirectory,m_IPCDirectoryFD))) ok=false;
+        if(ok && !HandleRequest(host,m_IPCDirectory,id)) ok=false;
+        if(ok && (NativeIPCRead(m_IPCDirectoryFD,"ack-"+id+".ready",ack)!=1 ||
+                  (ack!=payload+"status=staged\n" && ack!=payload+"status=rejected\n") || fsync(m_IPCDirectoryFD))) ok=false;
+        string random, moved;
+        if(ok && (!NativeRandomID(random) || !NativeIPCStable(m_IPCDirectory,m_IPCDirectoryFD))) ok=false;
+        if(ok)
+        {
+            moved=".consumed-"+random+".tmp";
+            if(syscall(SYS_renameat2,m_IPCDirectoryFD,"next.ready",m_IPCDirectoryFD,moved.c_str(),RENAME_NOREPLACE)) ok=false;
+            else if(fstatat(m_IPCDirectoryFD,moved.c_str(),&after,AT_SYMLINK_NOFOLLOW) ||
+                    before.st_dev!=after.st_dev || before.st_ino!=after.st_ino || before.st_size!=after.st_size ||
+                    NativeIPCRead(m_IPCDirectoryFD,moved,request)!=1 || request!=payload ||
+                    !NativeIPCStable(m_IPCDirectory,m_IPCDirectoryFD) || unlinkat(m_IPCDirectoryFD,moved.c_str(),0) ||
+                    fsync(m_IPCDirectoryFD) || !NativeIPCStable(m_IPCDirectory,m_IPCDirectoryFD)) ok=false;
+        }
+    }
+    catch(...) { ok=false; }
+    if(!ok) { if(!m_IPCBlocked) host->CountNativeRotationError( ); m_IPCBlocked=true; host->m_Enabled=false; }
+    return ok;
+#else
+    return false;
+#endif
+}
