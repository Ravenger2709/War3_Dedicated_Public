+static bool NativeReadFeedback( const string &path, map<string,uint64_t> &values )
+{
+	string data;
+	if( !NativeReadStatusFile( path, data ) ) return false;
+	static const char *keys[] = { "version", "observed_monotonic_ms", "connected", "authenticated", "publication_accepted", "relay_healthy", "last_ack_monotonic_ms", "publication_refresh_count", "publication_refresh_successes", "publication_refresh_failures" };
+	set<string> allowed( keys, keys + 10 );
+	stringstream lines( data );
+	string line;
+	while( getline( lines, line ) )
+	{
+		line = NativeTrim( line );
+		if( line.empty( ) || line[0] == '#' ) continue;
+		size_t eq = line.find( '=' );
+		if( eq == string::npos ) return false;
+		string key = NativeTrim( line.substr( 0, eq ) );
+		uint64_t value;
+		if( !allowed.count( key ) || values.count( key ) || !NativeUInt( NativeTrim( line.substr( eq + 1 ) ), value ) ) return false;
+		values[key] = value;
+	}
+	uint64_t time = NativeMonotonicMS( );
+	if( values.size( ) != 10 || values["version"] != 1 || !time || values["observed_monotonic_ms"] > time || time - values["observed_monotonic_ms"] > 10000 ) return false;
+	if( values["connected"] > 1 || values["authenticated"] > 1 || values["publication_accepted"] > 1 || values["relay_healthy"] > 1 || values["last_ack_monotonic_ms"] > values["observed_monotonic_ms"] ) return false;
+	if( values["publication_refresh_count"] > UINT32_MAX || values["publication_refresh_successes"] > UINT32_MAX || values["publication_refresh_failures"] > UINT32_MAX ) return false;
+	return true;
+}
+// Optional display-only sidecar. It never supplies a gameplay permission.
+static bool NativeReadCycleStatus( const string &path, map<string,string> &values )
+{
+    string data;
+    if(!NativeReadStatusFile(path,data)) return false;
+    static const char *keys[]={"version","observed_monotonic_ms","ttl_ms","session_generation",
+        "manifest_sha256","request_id","host_counter","catalog_index","cycle_position"};
+    set<string> allowed(keys,keys+9);
+    stringstream lines(data); string line;
+    while(getline(lines,line))
+    {
+        line=NativeTrim(line);
+        if(line.empty()) continue;
+        size_t eq=line.find('=');
+        if(eq==string::npos) return false;
+        string key=NativeTrim(line.substr(0,eq)), value=NativeTrim(line.substr(eq+1));
+        if(!allowed.count(key) || values.count(key) || value.empty()) return false;
+        values[key]=value;
+    }
+    if(values.size()!=9 || values["version"]!="1") return false;
+    const char *ids[]={"session_generation","manifest_sha256","request_id"};
+    for(size_t i=0;i<3;++i)
+        if(values[ids[i]].size()!=(i==1 ? 64 : 32) || values[ids[i]].find_first_not_of("0123456789abcdef")!=string::npos) return false;
+    const char *numbers[]={"observed_monotonic_ms","ttl_ms","host_counter","catalog_index","cycle_position"};
+    uint64_t parsed[5];
+    for(size_t i=0;i<5;++i) if(!NativeUInt(values[numbers[i]],parsed[i])) return false;
+    uint64_t now=NativeMonotonicMS();
+    return now && parsed[0]<=now && parsed[1]>=1 && parsed[1]<=10000 && now-parsed[0]<=parsed[1] &&
+        parsed[2]>0 && parsed[2]<(1u<<28) && parsed[3]<32 && parsed[4]<32;
+}
