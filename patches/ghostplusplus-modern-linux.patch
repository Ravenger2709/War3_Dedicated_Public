+        result->m_MaxGames=host->m_MaxGames; result->m_InputSizes=sizes;
+        for(size_t i=0;i<entries.size();++i)
+        {
+            const Descriptor &e=entries[i]; CConfig cfg; size_t pos=0;
+            while(pos<e.cfg.size())
+            {
+                size_t end=e.cfg.find('\n',pos), split=e.cfg.find(" = ",pos);
+                cfg.Set(e.cfg.substr(pos,split-pos),e.cfg.substr(split+3,end-split-3)); pos=end+1;
+            }
+            NativeNextPreset s={}; s.GameName=e.name;
+            s.MaxPlayers=e.values[0]; s.AutoStartEnabled=e.values[1]; s.DefaultAutoStartPlayers=e.values[2];
+            s.CountDownSeconds=e.values[3]; s.VoteEnabled=e.values[4]; s.VoteRequiredPercent=e.values[5];
+            s.VoteMinPlayers=e.values[6]; s.VoteTimeout=e.values[7]; s.VoteCooldown=e.values[8];
+            s.LobbyRefreshEnabled=e.values[9]; s.LobbyRefreshInterval=e.values[10]; s.LobbyAISupported=e.values[11];
+            s.LobbyAITarget=e.values[12]; s.LobbyAISkill=e.values[13]; s.LobbyMinHumans=e.values[14];
