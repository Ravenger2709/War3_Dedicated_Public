+// The game loop is single-threaded. Set the fence before publishing the
+// durable close; the old identity can never reach EventGameStarted afterwards.
+bool CBaseGame :: FenceNativeLobby( bool idleRotation )
+{
+    if( !m_GHost->m_StartReservationGate || m_GHost->m_CurrentGame != this || m_GameLoading || m_GameLoaded ) return true;
+    if( m_NativeFenced ) return m_NativeCloseRecorded;
+    m_NativeFenced = true;
+    // Exhausted counters are never reservable; ambiguous start journal errors
+    // must never be converted into proof that no start was committed.
+    if( m_HostCounter == 0 || m_HostCounter > 0x0fffffff ) { m_NativeCloseRecorded = true; return true; }
+    if( !m_GHost->m_LifecycleWriteFailed && m_GHost->PersistNativeLobbyClosed( m_HostCounter, m_NativeCatalogRequestID, m_NativeCatalogDigest, m_NativeCatalogIndex, idleRotation ) )
+    {
+        m_NativeCloseRecorded = true;
+        return true;
+    }
+    CONSOLE_Print( "[GHOST] lifecycle close write failed; disabling new games" );
+    m_Exiting = true;
+    m_GHost->m_Enabled = false;
+    if( !m_GHost->m_LifecycleWriteFailed && m_GHost->m_NativeCatalogOnly ) m_GHost->CountNativeRotationError( );
+		m_GHost->m_LifecycleWriteFailed = true;
+    return false;
+}
+
+// Runs on the native admission/event-loop thread after player updates.
+// Computer slots and the virtual host are not human connections. Potentials
+// defer expiry without restarting the timer (health probes must not pin a map).
+bool CBaseGame :: UpdateNativeEmptyRotation( )
+{
+    uint32_t index = 0;
+    if( !m_GHost->m_NativeCatalogOnly || !m_GHost->m_StartReservationGate ||
+        !m_GHost->m_EmptyLobbyRotationSeconds || m_GHost->m_CurrentGame != this ||
+        m_Exiting || m_NativeFenced || m_GameLoading || m_GameLoaded || m_CountDownStarted ||
+        !m_Players.empty( ) || !NativeCatalogIndex( index ) )
+    {
+        m_NativeEmptySinceMS = 0;
+        return false;
+    }
+    uint64_t now = NativeMonotonicMS( );
+    if( !m_NativeEmptySinceMS || now < m_NativeEmptySinceMS ) m_NativeEmptySinceMS = now;
+    if( now - m_NativeEmptySinceMS < (uint64_t)m_GHost->m_EmptyLobbyRotationSeconds * 1000 ||
+        !m_Potentials.empty( ) || !m_GHost->NativeStartReserved( m_HostCounter ) ) return false;
+    // The same event-loop iteration has just checked the actual player list.
+    // Persist an explicit idle close before deletion; never forge a game start.
+    RestoreNativeRefresh( false );
+    if( !FenceNativeLobby( true ) ) return false;
+    CONSOLE_Print( "[GHOST] empty lobby timeout reached; advancing map rotation" );
+    m_Exiting = true;
+    m_GHost->m_LastAutoHostTime = GetTime( ) - 30;
+    return true;
+}
+
+void CBaseGame :: ResetNativeLobbyFence( )
+{
+    m_NativeFenced = m_NativeCloseRecorded = false;
+}
