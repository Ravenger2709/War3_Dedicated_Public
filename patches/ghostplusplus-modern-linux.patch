+#ifndef WIN32
+// The supported layout is a cgroup v2 namespace rooted at the container's
+// cgroup. Never guess an unlimited value or a path outside that namespace.
+static bool NativeReadCgroupCounter( int directory, const char *name, uint64_t &value )
+{
+    int fd = openat( directory, name, O_RDONLY | O_CLOEXEC | O_NOFOLLOW );
+    if( fd < 0 ) return false;
+    char buffer[64]; size_t length = 0;
+    while( length < sizeof buffer )
+    {
+        ssize_t n = read( fd, buffer + length, sizeof buffer - length );
+        if( n < 0 && errno == EINTR ) continue;
+        if( n < 0 ) { close( fd ); return false; }
+        if( n == 0 ) break;
+        length += n;
+    }
+    close( fd );
+    if( length < 2 || length == sizeof buffer || buffer[length-1] != '\n' ) return false;
+    value = 0;
+    for( size_t i = 0; i + 1 < length; ++i )
+    {
+        if( buffer[i] < '0' || buffer[i] > '9' ) return false;
+        unsigned digit = buffer[i] - '0';
+        if( value > ( std::numeric_limits<uint64_t>::max( ) - digit ) / 10 ) return false;
+        value = value * 10 + digit;
+    }
+    return true;
+}
+#endif
+
+bool NativePreloadCgroupSnapshot( uint64_t &current, uint64_t &limit )
+{
+    current = limit = 0;
+#ifndef WIN32
+    int proc = open( "/proc/self/cgroup", O_RDONLY | O_CLOEXEC | O_NOFOLLOW );
+    if( proc < 0 ) return false;
+    char membership[16]; size_t used = 0;
+    while( used < sizeof membership )
+    {
+        ssize_t n = read( proc, membership + used, sizeof membership - used );
+        if( n < 0 && errno == EINTR ) continue;
+        if( n < 0 ) { close( proc ); return false; }
+        if( n == 0 ) break;
+        used += n;
+    }
+    close( proc );
+    if( used != 5 || memcmp( membership, "0::/\n", 5 ) ) return false;
+    int directory = open( "/sys/fs/cgroup", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW );
+    if( directory < 0 ) return false;
+    struct statfs info;
+    bool ok = !fstatfs( directory, &info ) && (unsigned long)info.f_type == CGROUP2_SUPER_MAGIC &&
+        NativeReadCgroupCounter( directory, "memory.max", limit ) && limit &&
+        NativeReadCgroupCounter( directory, "memory.current", current ) && current <= limit;
+    close( directory );
+    if( !ok ) current = limit = 0;
+    return ok;
+#else
+    return false;
+#endif
+}
