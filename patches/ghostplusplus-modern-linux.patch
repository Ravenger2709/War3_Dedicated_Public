+// Every lifecycle operation must still refer to the directory pinned at startup.
+int CGHost :: NativeOpenLifecycleDirectory( )
+{
+#ifndef WIN32
+    if( m_LifecycleDirFD < 0 ) return -1;
+    int dir = NativeStatusDirectory( m_LifecycleDirectory );
+    struct stat pinned, current;
+    if( dir < 0 ) return -1;
+    if( fstat( m_LifecycleDirFD, &pinned ) || fstat( dir, &current ) ||
+        pinned.st_dev != current.st_dev || pinned.st_ino != current.st_ino ||
+        (unsigned long)current.st_dev != m_LifecycleDirDevice || (unsigned long)current.st_ino != m_LifecycleDirInode )
+    { close( dir ); return -1; }
+    return dir;
+#else
+    return -1;
+#endif
+}
