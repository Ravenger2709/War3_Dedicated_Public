+#ifndef WIN32
+// Read a small pseudo-file without following symlinks or accepting truncation.
+static bool NativeCgroupText( int dir, const char *name, size_t cap, string &out )
+{
+    int fd=openat(dir,name,O_RDONLY|O_CLOEXEC|O_NOFOLLOW);
+    if(fd<0) return false;
+    out.clear(); char bytes[4096]; bool ok=true;
+    while(true)
+    {
+        ssize_t n=read(fd,bytes,sizeof bytes);
+        if(n<0 && errno==EINTR) continue;
+        if(n<0) { ok=false; break; }
+        if(n==0) break;
+        if((size_t)n>cap-out.size()) { ok=false; break; }
+        out.append(bytes,(size_t)n);
+    }
+    close(fd); return ok;
+}
+
+static bool NativeCgroupUInt( const string &text, uint64_t &out )
+{
+    if(text.size()<2 || text[text.size()-1]!='\n') return false;
+    out=0;
+    for(size_t i=0;i+1<text.size();++i)
+    {
+        char c=text[i];
+        if(c<'0'||c>'9'||out>(std::numeric_limits<uint64_t>::max()-(c-'0'))/10) return false;
+        out=out*10+c-'0';
+    }
+    return true;
+}
+
+static bool NativeCgroupMembership( string &path )
+{
+    int proc=open("/proc/self",O_RDONLY|O_CLOEXEC|O_DIRECTORY);
+    if(proc<0) return false;
+    string text; bool ok=NativeCgroupText(proc,"cgroup",4096,text); close(proc);
+    if(!ok || text.size()<5 || text.compare(0,4,"0::/") || text[text.size()-1]!='\n' ||
+       text.find('\n')!=text.size()-1) return false;
+    path=text.substr(3,text.size()-4);
+    return true;
+}
+
+static bool NativeCgroupContainsSelf( int dir )
+{
+    string text;
+    if(!NativeCgroupText(dir,"cgroup.procs",1024*1024,text)) return false;
+    ostringstream out; out << getpid(); string expected=out.str();
+    size_t pos=0;
+    while(pos<text.size())
+    {
+        size_t end=text.find('\n',pos);
+        if(end==string::npos) return false;
+        if(text.substr(pos,end-pos)==expected) return true;
+        pos=end+1;
+    }
+    return false;
+}
+#endif
