+string CGHost :: NativeStatusNextPreset( ) const
+{
+#ifndef WIN32
+    CBaseGame *anchor=m_CurrentGame ? m_CurrentGame : m_Games.empty() ? NULL : m_Games.back();
+    CNativeStartupCatalog *catalog=m_NativeAdmissionCatalog;
+    uint32_t index=0;
+    if(!m_LifecycleValid || !catalog || !anchor || !anchor->NativeCatalogIndex(index) ||
+       anchor->NativeCatalogDigest()!=catalog->Digest() || m_ExternalStatusPath.empty()) return "unavailable";
+    map<string,string> feedback;
+    if(!NativeReadCycleStatus(m_ExternalStatusPath+".cycle",feedback) ||
+       feedback["session_generation"]!=m_LifecycleGeneration || feedback["manifest_sha256"]!=catalog->Digest() ||
+       feedback["request_id"]!=anchor->NativeCatalogRequestID()) return "unavailable";
+    uint64_t counter=0, reportedIndex=0, position=0, observed=0;
+    if(!NativeUInt(feedback["host_counter"],counter) || !NativeUInt(feedback["catalog_index"],reportedIndex) ||
+       !NativeUInt(feedback["cycle_position"],position) || !NativeUInt(feedback["observed_monotonic_ms"],observed) ||
+       observed<m_NativeStartedMS || counter!=anchor->GetHostCounter() || reportedIndex!=index ||
+       position>=catalog->CycleCount() || catalog->CycleIndex(position)!=index) return "unavailable";
+    // Position is supplied by the leased cursor, never guessed from a repeated ID.
+    return catalog->ID(catalog->CycleIndex((position+1)%catalog->CycleCount()));
+#else
+    return "unavailable";
+#endif
