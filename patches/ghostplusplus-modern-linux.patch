+        for(size_t i=0;i<occurrences;++i) result->m_Cycle.push_back((unsigned char)data[cursor+i]);
+    }
+    catch(...) { delete result; result=NULL; }
+    for(size_t i=0;i<inputs.size();++i) close(inputs[i]);
+    close(stable); return result;
+#else
+    return NULL;
+#endif
