+// inode. Check the task is actually in the path before accepting any result.
+// This is a point-in-time admission snapshot, not an RSS guarantee.
+bool NativePreloadCgroupHeadroom( uint64_t &headroom )
+{
+    headroom=0;
+#ifndef WIN32
+    string membership;
+    if(!NativeCgroupMembership(membership)) return false;
+    int dir=open("/sys/fs/cgroup",O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW);
