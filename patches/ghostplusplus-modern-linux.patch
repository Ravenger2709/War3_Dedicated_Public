+bool NativePreloadManifestEnvelope( int manifestFD, uint32_t expectedGames, uint64_t expectedDefault,
+    uint64_t current, uint64_t limit, uint64_t &required )
+{
+    required = 0;
+#ifndef WIN32
+    struct stat st;
+    if( manifestFD < 3 || fstat( manifestFD, &st ) || st.st_size < 30 || st.st_size > 262144 ||
+        !NativeManifestFD( manifestFD, (uint64_t)st.st_size ) ) return false;
+    string data; data.resize( (size_t)st.st_size ); size_t done = 0;
+    while( done < data.size( ) )
+    {
+        ssize_t n = pread( manifestFD, &data[done], data.size( ) - done, (off_t)done );
+        if( n < 0 && errno == EINTR ) continue;
+        if( n <= 0 ) return false;
+        done += n;
+    }
+    if( data.compare( 0, 8, "W3PRLD01" ) ) return false;
+    uint64_t count = NativeManifestLE(data,8,2), occurrences = NativeManifestLE(data,10,2);
+    uint64_t games = NativeManifestLE(data,12,1), reserved = NativeManifestLE(data,13,1);
+    uint64_t defaultSize = NativeManifestLE(data,14,8), claimed = NativeManifestLE(data,22,8);
+    if( count < 1 || count > 32 || occurrences < 1 || occurrences > 32 || reserved ||
+        games != expectedGames || defaultSize != expectedDefault ) return false;
+    size_t cursor = 30; set<string> ids; set<int> fds; vector<uint64_t> sizes;
+    struct HashCheck { int fd; uint64_t size; string digest; };
+    vector<HashCheck> hashes;
+    for( size_t index = 0; index < count; ++index )
+    {
+        if( data.size( ) - cursor < 110 ) return false;
+        uint64_t fd = NativeManifestLE(data,cursor,4), size = NativeManifestLE(data,cursor+4,8);
+        string digest = data.substr(cursor+12,32);
+        uint64_t idlen = NativeManifestLE(data,cursor+44,1), namelen = NativeManifestLE(data,cursor+45,1), cfglen = NativeManifestLE(data,cursor+46,4);
+        if( !NativeManifestSettings(data,cursor+50) ) return false;
+        cursor += 110; // entry header (50) plus fifteen uint32 settings
+        if( fd > 0x7fffffff || fd < 3 || (int)fd == manifestFD || !fds.insert((int)fd).second ||
+            size < 1 || size > NATIVE_MAP_FILE_MAX || idlen < 1 || idlen > 32 || namelen < 1 || namelen > 24 ||
+            cfglen < 1 || cfglen > 8192 || idlen + namelen + cfglen > data.size( ) - cursor ) return false;
+        string id = data.substr(cursor,idlen);
+        for( size_t i = 0; i < id.size( ); ++i )
+            if( !( id[i] >= 'a' && id[i] <= 'z' ) && !( id[i] >= '0' && id[i] <= '9' ) &&
+                !( i && ( id[i] == '_' || id[i] == '-' ) ) ) return false;
+        if( !ids.insert(id).second || !NativeManifestFD((int)fd,size) ||
+            !NativeManifestName(data.substr(cursor+idlen,namelen)) ||
+            !NativeManifestConfig(data.substr(cursor+idlen+namelen,cfglen)) ) return false;
+        cursor += idlen + namelen + cfglen;
+        sizes.push_back(size);
+        HashCheck check = { (int)fd, size, digest }; hashes.push_back(check);
+    }
+    if( data.size( ) - cursor != occurrences ) return false;
+    for( size_t i = 0; i < occurrences; ++i ) if( (unsigned char)data[cursor+i] >= count ) return false;
+    uint64_t producer = 128ULL * 1024 * 1024, largest = defaultSize;
+    if( !defaultSize || defaultSize > NATIVE_MAP_FILE_MAX ) return false;
+    for( size_t i = 0; i < sizes.size( ); ++i ) { producer += 2*sizes[i]; largest = max(largest,sizes[i]); }
+    producer += 2*defaultSize + largest * (games+3);
+    if( producer != claimed || producer > 512ULL*1024*1024 ||
+        !NativePreloadAdmissionBudget(sizes,defaultSize,0,(uint32_t)games,current,limit,required) ) return false;
+    for( size_t i = 0; i < hashes.size( ); ++i )
+        if( !NativeManifestHashFD(hashes[i].fd,hashes[i].size,(const unsigned char *)hashes[i].digest.data( )) ) return false;
+    return true;
+#else
+    return false;
+#endif
+}
