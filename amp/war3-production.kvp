Meta.DisplayName=War3_Dedicated
Meta.Description=
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=War3_Dedicated
Meta.URL=https://github.com/Ravenger2709/War3_Dedicated_Public
Meta.DisplayImageSource=url:https://blz-contentstack-images.akamaized.net/v3/assets/blt9c12f249ac15c7ec/blt806d59ff0b4e0508/6aa88158ad9209ba7f5629ef/rebirth_og.png
Meta.EndpointURIFormat=
Meta.ConfigManifest=war3-productionconfig.json
Meta.MetaConfigManifest=war3-productionmetaconfig.json
Meta.ConfigRoot=war3-production.kvp
Meta.MinAMPVersion=2.5.0.8
Meta.SpecificDockerImage=war3-amp-control:phase3-candidate
Meta.DockerRequired=True
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=Containerized trusted AMP control launches the gated sibling runtime through the host daemon.
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=Uses a locally verified runtime image. Account and map changes apply on Start/Restart.
Meta.AppConfigId=9a8f6b63-2bd0-49c5-846b-91f08320815e
App.DisplayName=Warcraft III
App.RootDir=./war3-production/
App.BaseDirectory=./war3-production/
App.ExecutableWin=
App.ExecutableLinux=/usr/bin/python3
App.WorkingDir=.
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=control/production-launch.py --instance-dir "{{$FullBaseDir}}"
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat={0}={1}
App.ExitMethod=SIGTERM
App.ExitTimeout=150
App.ExitString=quit
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[war3-productionports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=GamePort
App.MaxUsers=12
App.UseRandomAdminPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.UpdateSources=@IncludeJson[war3-productionupdates.json]
App.PreStartStages=[]
App.ForceUpdate=False
App.Compatibility=None
App.RapidStartup=False
App.MonitorChildProcess=False
App.SupportsUniversalSleep=False
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} ((?:INFO|WARN|ERROR) (?:supervisor|native|star|relay|realm): .*)$
Console.FilterMatchReplacement=$1
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^(?:[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} )?INFO supervisor: (?:Lobby is ready|Countdown is running|Game is running)\.$
Console.UserJoinRegex=^(?:[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} )?INFO native: Player joined: (?<username>(?!\s)[^\x00-\x1F\x7F\[\]|<>"\\\uFFFD]{1,64}(?<!\s))$
Console.UserLeaveRegex=^(?:[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} )?INFO native: Player left: (?<username>(?!\s)[^\x00-\x1F\x7F\[\]|<>"\\\uFFFD]{1,64}(?<!\s))$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.SuppressLogAtStart=False
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.AutoRetryCount=3
