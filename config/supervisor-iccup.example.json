{
  "mode": "iccup",
  "hostbot": {
    "command": [
      "/opt/war3/bin/ghost++",
      "/data/state/native/ghost.cfg"
    ],
    "cwd": "/data",
    "startup_timeout": 90,
    "stop_timeout": 20,
    "lobby_timeout": 3600
  },
  "http": {
    "host": "127.0.0.1",
    "port": 8080
  },
  "runtime_dir": "/data/state/supervisor",
  "recovery": {
    "max_restarts": 5,
    "backoff_initial": 5,
    "backoff_max": 120,
    "stable_seconds": 300
  },
  "iccup": {
    "adapter": "original-star-v1",
    "upstream": "57.129.6.91",
    "vendor": "/vendor/star",
    "profile": "/vendor/profile",
    "redist": "/vendor/redist/vc_redist.x86.exe",
    "game_metadata": "/vendor/game",
    "prefix": "/data/prefix",
    "session": "/data/session",
    "manifest": "/opt/war3/config/star-vendor-files.json",
    "quit_helper": "/opt/war3/bin/quit-launcher.exe",
    "native_config": "/data/config/ghost.cfg",
    "bridge_dir": "/data/state/bridge",
    "relay_port": 16112,
    "auth_timeout": 180,
    "disconnect_grace": 5,
    "publication_interval": 30,
    "metadata_ttl": 3,
    "native_state_ttl": 15
  },
  "gameplay": {
    "host_name": "War3HostBot",
    "game_name": "War3 Dedicated",
    "game_port": 6113,
    "max_players": 12,
    "autostart_players": 10,
    "countdown_seconds": 5,
    "vote_enabled": true,
    "vote_min_players": 2,
    "vote_required_percent": 60,
    "vote_timeout": 60,
    "vote_cooldown": 30,
    "lobby_refresh_enabled": true,
    "lobby_refresh_interval": 10,
    "lobby_message_interval": 20,
    "lobby_refresh_mode": "slot_toggle",
    "autohost_enabled": true,
    "reconnect_enabled": true,
    "empty_lobby_rotation_minutes": 10
  }
}
